root = true

[*]
end_of_line = lf

[*.cs]
# VSTHRD003: view-model flows await stored tasks (pending saves, queued refreshes) by design; the UI context is not a JoinableTaskFactory
dotnet_diagnostic.VSTHRD003.severity = none
# VSTHRD001: SynchronizationContext.Post is the only way to marshal to the WPF UI thread without a JoinableTaskFactory
dotnet_diagnostic.VSTHRD001.severity = none
# VSTHRD200: naming-only rule; existing public API names (RequestCheck, DueRefresh) are intentional
dotnet_diagnostic.VSTHRD200.severity = none
dotnet_diagnostic.VSTHRD100.severity = error
dotnet_diagnostic.VSTHRD101.severity = error
dotnet_diagnostic.VSTHRD110.severity = error
