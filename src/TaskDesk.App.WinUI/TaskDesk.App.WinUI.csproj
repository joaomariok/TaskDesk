<Project Sdk="Microsoft.NET.Sdk">
  <!-- The WinUI shell exe (ADR 0004): start-up on the Generic Host, tray, single instance and the main window's
       lifecycle. Root namespace TaskDesk.App, so the shell sources it shares with the WPF app compile unchanged;
       its own assembly name until the swap (#68), when it becomes TaskDesk.App. Runs in sandbox mode only
       (TASKDESK_DATA_DIR set) until then. Keep <UseWinUI>true</UseWinUI> literal (WinUI XAML guardrail). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TaskDesk.App.WinUI</AssemblyName>
    <RootNamespace>TaskDesk.App</RootNamespace>
    <ApplicationIcon>..\TaskDesk.App\Assets\TaskDesk.ico</ApplicationIcon>
    <!-- LibraryImport (user32) generates marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\TaskDesk.App\Assets\TaskDesk.ico" Link="Assets\TaskDesk.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Non-UI shell implementations, shared by source with the WPF app until the swap. -->
    <Compile Include="..\TaskDesk.App\Shell\NamedPipeSingleInstance.cs" Link="Shell\NamedPipeSingleInstance.cs" />
    <Compile Include="..\TaskDesk.App\Shell\RegistryRunKey.cs" Link="Shell\RegistryRunKey.cs" />
    <Compile Include="..\TaskDesk.App\Shell\ExplorerFolderOpener.cs" Link="Shell\ExplorerFolderOpener.cs" />
    <Compile Include="..\TaskDesk.App\Notifications\AppSdkNotificationService.cs" Link="Notifications\AppSdkNotificationService.cs" />
    <Compile Include="..\TaskDesk.App\Notifications\TrayBalloonNotificationService.cs" Link="Notifications\TrayBalloonNotificationService.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TaskDesk.Core\TaskDesk.Core.csproj" />
    <ProjectReference Include="..\TaskDesk.Data\TaskDesk.Data.csproj" />
    <ProjectReference Include="..\TaskDesk.Presentation\TaskDesk.Presentation.csproj" />
    <ProjectReference Include="..\TaskDesk.Views\TaskDesk.Views.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="..\TaskDesk.App\WindowsAppSdkPayload.targets" />
</Project>
