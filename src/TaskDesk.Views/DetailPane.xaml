<?xml version="1.0" encoding="utf-8"?>
<!--
    The detail pane of a Task, opened on demand: a fixed header (Close, the Task's checkbox and title, and any
    error that belongs to no field) over the fields, which scroll. Every field has a visible label above it, and
    a validation error shows right under its field. DetailDock places the pane beside the list or over it.
-->
<UserControl
    x:Class="TaskDesk.Views.DetailPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskDesk.Views"
    xmlns:presentation="using:TaskDesk.Presentation"
    xmlns:tags="using:TaskDesk.Core.Tags">
    <UserControl.Resources>
        <!-- The row's icon button made smaller, for each Subtask's move and delete buttons. -->
        <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A Reminder row: its text as a quiet, full-width button that opens the Reminder flyout. -->
        <Style x:Key="ReminderRowButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <!-- The row's Tag chip, with room on the right for its remove button. -->
        <Style x:Key="DetailTagChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,1,2,1" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="DetailTagChipText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxWidth" Value="160" />
        </Style>
        <!-- The quiet round button inside a Tag chip. -->
        <Style x:Key="TagRemoveButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- An error in Overdue red; it takes no room while there is none. -->
        <Style x:Key="FieldErrorText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Foreground" Value="{ThemeResource OverdueBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,-8,0,12" />
        </Style>
        <!-- Small icon-only button (Close): square, no border. -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <!-- A button that is available but not tempting: no fill, no border, critical-coloured text. -->
        <Style x:Key="QuietDangerButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource OverdueBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <Border x:Name="PaneRoot"
            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The fixed header, parted from the fields scrolling under it by a hairline. -->
            <Border x:Name="Header" Grid.Row="0" Padding="16,12,16,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Details" Style="{StaticResource SubtitleText}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                ToolTipService.ToolTip="Close (Esc)"
                                AutomationProperties.Name="Close detail pane"
                                Click="OnCloseClick">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- Title with the Task's checkbox, which completes it like the checkbox on its row. -->
                    <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                    <Grid Margin="{StaticResource FieldMargin}" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:CommandCheckBox x:Name="DetailCompletedBox" VerticalAlignment="Center"
                                               MinWidth="0" MinHeight="0" Padding="0"
                                               AutomationProperties.Name="Completed"
                                               AutomationProperties.AutomationId="DetailCompletedBox"
                                               IsChecked="{x:Bind ViewModel.DetailTask.IsCompleted, Mode=OneWay, FallbackValue=False}"
                                               Command="{x:Bind ViewModel.ToggleCompleteCommand, Mode=OneTime}"
                                               CommandParameter="{x:Bind ViewModel.DetailTask, Mode=OneWay}" />
                        <TextBox x:Name="DetailTitleBox" Grid.Column="1" MaxLength="500"
                                 AutomationProperties.Name="Task title"
                                 AutomationProperties.AutomationId="DetailTitleBox"
                                 Text="{x:Bind ViewModel.DetailTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <!-- An error that belongs to no field, such as a failed save: here it is never scrolled away. -->
                    <TextBlock x:Name="GeneralErrorText" Style="{StaticResource FieldErrorText}"
                               Text="{x:Bind ViewModel.GeneralError, Mode=OneWay}"
                               Visibility="{x:Bind local:DetailPane.ShownWithText(ViewModel.GeneralError), Mode=OneWay, FallbackValue=Collapsed}" />
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="Fields" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,12,16,16">
                    <!-- Subtasks with their progress, each with its checkbox, title, move and delete buttons. -->
                    <Grid>
                        <TextBlock Text="Subtasks" Style="{StaticResource FieldLabel}" />
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Style="{StaticResource SecondaryCaptionText}"
                                   AutomationProperties.Name="Subtask progress"
                                   Text="{x:Bind local:DetailPane.ProgressText(ViewModel.DetailTask.SubtaskProgress), Mode=OneWay, FallbackValue=''}" />
                    </Grid>
                    <ItemsControl x:Name="SubtaskList" Margin="0,0,0,4" IsTabStop="False"
                                  AutomationProperties.Name="Subtasks"
                                  ItemsSource="{x:Bind ViewModel.SubtaskItems, Mode=OneTime}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="presentation:SubtaskRowViewModel">
                                <Grid Margin="0,2" ColumnSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- The Toggle pattern runs the command once; the bound state shows the tick. -->
                                    <local:CommandCheckBox VerticalAlignment="Center" Margin="0,0,4,0"
                                                           MinWidth="0" MinHeight="0" Padding="0"
                                                           AutomationProperties.Name="Subtask done"
                                                           IsChecked="{x:Bind IsCompleted, Mode=OneWay}"
                                                           Command="{x:Bind local:DetailPane.ToggleSubtaskCommand, Mode=OneTime}"
                                                           CommandParameter="{x:Bind Mode=OneTime}" />
                                    <TextBox Grid.Column="1" MaxLength="500"
                                             AutomationProperties.Name="Subtask title"
                                             Text="{x:Bind Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    <Button Grid.Column="2" Style="{StaticResource SmallIconButton}"
                                            ToolTipService.ToolTip="Move up"
                                            AutomationProperties.Name="Move subtask up"
                                            Click="OnMoveSubtaskUpClick">
                                        <FontIcon Glyph="&#xE70E;" FontSize="12" />
                                    </Button>
                                    <Button Grid.Column="3" Style="{StaticResource SmallIconButton}"
                                            ToolTipService.ToolTip="Move down"
                                            AutomationProperties.Name="Move subtask down"
                                            Click="OnMoveSubtaskDownClick">
                                        <FontIcon Glyph="&#xE70D;" FontSize="12" />
                                    </Button>
                                    <Button Grid.Column="4" Style="{StaticResource SmallIconButton}"
                                            ToolTipService.ToolTip="Delete subtask"
                                            AutomationProperties.Name="Delete subtask"
                                            Click="OnDeleteSubtaskClick">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="{StaticResource FieldMargin}" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewSubtaskBox" MaxLength="500" PlaceholderText="Add a subtask"
                                 AutomationProperties.Name="New subtask title"
                                 Text="{x:Bind ViewModel.NewSubtaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnAddBoxKeyDown" />
                        <Button Grid.Column="1" Content="Add"
                                AutomationProperties.Name="Add subtask"
                                Command="{x:Bind ViewModel.AddSubtaskCommand, Mode=OneTime}" />
                    </Grid>

                    <!-- Due: a calendar date, then an optional time picked once the date is set. -->
                    <TextBlock Text="Due" Style="{StaticResource FieldLabel}" />
                    <CalendarDatePicker x:Name="DetailDueDatePicker" HorizontalAlignment="Stretch"
                                        Margin="{StaticResource FieldMargin}"
                                        AutomationProperties.Name="Due date"
                                        AutomationProperties.AutomationId="DetailDueDatePicker"
                                        Date="{x:Bind local:DetailPane.ToPickerDate(ViewModel.DetailDueDate), BindBack=SetDueDate, Mode=TwoWay, FallbackValue={x:Null}}" />
                    <!-- The clock follows the system 12/24-hour setting (no ClockIdentifier). MinWidth 0 lets the
                         picker fit the pane's narrowest width; the Fluent default is 242. -->
                    <TextBlock Text="Due time" Style="{StaticResource FieldLabel}" />
                    <Grid Margin="{StaticResource FieldMargin}" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TimePicker x:Name="DueTimePicker" HorizontalAlignment="Stretch" MinWidth="0"
                                    MinuteIncrement="1"
                                    AutomationProperties.Name="Due time"
                                    AutomationProperties.AutomationId="DueTimePicker"
                                    AutomationProperties.HelpText="Needs a Due date"
                                    IsEnabled="{x:Bind ViewModel.HasDetailDue, Mode=OneWay}"
                                    SelectedTime="{x:Bind ViewModel.DetailDueTime, Mode=TwoWay}" />
                        <Button x:Name="ClearDueTimeButton" Grid.Column="1" Style="{StaticResource SmallIconButton}"
                                ToolTipService.ToolTip="Clear Due time"
                                AutomationProperties.Name="Clear Due time"
                                AutomationProperties.AutomationId="ClearDueTimeButton"
                                Command="{x:Bind ViewModel.ClearDetailDueTimeCommand, Mode=OneTime}">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                    <TextBlock x:Name="DueErrorText" Style="{StaticResource FieldErrorText}"
                               Text="{x:Bind ViewModel.DueError, Mode=OneWay}"
                               Visibility="{x:Bind local:DetailPane.ShownWithText(ViewModel.DueError), Mode=OneWay, FallbackValue=Collapsed}" />

                    <!-- Reminders: one row per Reminder, the first to fire first. A click on a row opens the flyout
                         on it, its × removes it, and "Add reminder" opens the flyout on a new one. -->
                    <StackPanel x:Name="ReminderSection">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="ReminderFlyout" Placement="Bottom" Opened="OnReminderFlyoutOpened"
                                    Closed="OnReminderFlyoutClosed">
                                <StackPanel x:Name="ReminderEditorPanel" MinWidth="240" Spacing="4"
                                            AutomationProperties.Name="Reminder editor">
                                    <TextBlock Style="{StaticResource BodyStrongText}"
                                               Text="{x:Bind ReminderEditor.Heading, Mode=OneWay}" />
                                    <!-- The mode: a fixed date and time, or some time before the Due (only while
                                         the Task has a Due). -->
                                    <TextBlock Text="When" Style="{StaticResource FieldLabel}" />
                                    <RadioButtons x:Name="ReminderModeButtons" MaxColumns="2"
                                                  AutomationProperties.Name="When"
                                                  AutomationProperties.AutomationId="ReminderModeButtons"
                                                  SelectedIndex="{x:Bind ReminderEditor.ModeIndex, Mode=TwoWay}">
                                        <RadioButton x:Name="DateAndTimeModeButton" Content="Date and time"
                                                     AutomationProperties.AutomationId="DateAndTimeModeButton" />
                                        <RadioButton x:Name="BeforeDueModeButton" Content="Before Due"
                                                     AutomationProperties.AutomationId="BeforeDueModeButton"
                                                     AutomationProperties.HelpText="Needs a Due"
                                                     IsEnabled="{x:Bind ReminderEditor.CanUseBeforeDue, Mode=OneWay}" />
                                    </RadioButtons>
                                    <StackPanel x:Name="DateAndTimePanel" Spacing="4"
                                                Visibility="{x:Bind ReminderEditor.IsDateAndTime, Mode=OneWay}">
                                        <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
                                        <CalendarDatePicker x:Name="ReminderDatePicker" HorizontalAlignment="Stretch"
                                                            AutomationProperties.Name="Reminder date"
                                                            AutomationProperties.AutomationId="ReminderDatePicker"
                                                            Date="{x:Bind local:DetailPane.ToPickerDate(ReminderEditor.Date), BindBack=SetReminderDate, Mode=TwoWay, FallbackValue={x:Null}}" />
                                        <!-- The time is optional: left empty, the Reminder fires at the default
                                             Reminder time. -->
                                        <TextBlock Text="Time (optional)" Style="{StaticResource FieldLabel}" />
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TimePicker x:Name="ReminderTimePicker" HorizontalAlignment="Stretch" MinWidth="0"
                                                        MinuteIncrement="1"
                                                        AutomationProperties.Name="Reminder time"
                                                        AutomationProperties.AutomationId="ReminderTimePicker"
                                                        AutomationProperties.HelpText="Needs a date; left empty, the Reminder fires at the default Reminder time"
                                                        IsEnabled="{x:Bind ReminderEditor.HasDate, Mode=OneWay}"
                                                        SelectedTime="{x:Bind ReminderEditor.Time, Mode=TwoWay}" />
                                            <Button x:Name="ClearReminderTimeButton" Grid.Column="1"
                                                    Style="{StaticResource SmallIconButton}"
                                                    ToolTipService.ToolTip="Clear Reminder time"
                                                    AutomationProperties.Name="Clear Reminder time"
                                                    AutomationProperties.AutomationId="ClearReminderTimeButton"
                                                    Command="{x:Bind ReminderEditor.ClearTimeCommand, Mode=OneTime}">
                                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                    <!-- Before Due: a preset, or "Custom…" with a whole number (1 to 999) and a unit. -->
                                    <StackPanel x:Name="BeforeDuePanel" Spacing="4"
                                                Visibility="{x:Bind ReminderEditor.IsBeforeDue, Mode=OneWay}">
                                        <TextBlock Text="Time before Due" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="BeforeDueOffsetBox" HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Time before Due"
                                                  AutomationProperties.AutomationId="BeforeDueOffsetBox"
                                                  ItemsSource="{x:Bind presentation:ReminderEditorViewModel.OffsetChoices, Mode=OneTime}"
                                                  SelectedIndex="{x:Bind ReminderEditor.OffsetIndex, Mode=TwoWay}" />
                                        <Grid x:Name="CustomOffsetRow" ColumnSpacing="8"
                                              Visibility="{x:Bind ReminderEditor.IsCustomShown, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Number" Style="{StaticResource FieldLabel}" />
                                            <NumberBox x:Name="CustomAmountBox" Grid.Row="1" MinWidth="0"
                                                       Minimum="1" Maximum="999" SmallChange="1" LargeChange="10"
                                                       SpinButtonPlacementMode="Compact"
                                                       AutomationProperties.Name="Number before Due"
                                                       AutomationProperties.AutomationId="CustomAmountBox"
                                                       AutomationProperties.HelpText="A whole number from 1 to 999"
                                                       Value="{x:Bind ReminderEditor.CustomAmount, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="1" Text="Unit" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="CustomUnitBox" Grid.Row="1" Grid.Column="1"
                                                      HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="Unit before Due"
                                                      AutomationProperties.AutomationId="CustomUnitBox"
                                                      ItemsSource="{x:Bind presentation:ReminderEditorViewModel.UnitChoices, Mode=OneTime}"
                                                      SelectedIndex="{x:Bind ReminderEditor.CustomUnitIndex, Mode=TwoWay}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                                                Margin="0,8,0,0">
                                        <Button x:Name="CancelReminderButton" Content="Cancel"
                                                AutomationProperties.Name="Cancel"
                                                AutomationProperties.AutomationId="CancelReminderButton"
                                                Command="{x:Bind ReminderEditor.CancelCommand, Mode=OneTime}" />
                                        <Button x:Name="SaveReminderButton" Content="Save"
                                                Style="{StaticResource AccentButtonStyle}"
                                                AutomationProperties.Name="Save reminder"
                                                AutomationProperties.AutomationId="SaveReminderButton"
                                                Command="{x:Bind ReminderEditor.SaveCommand, Mode=OneTime}" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                        <TextBlock Text="Reminders" Style="{StaticResource FieldLabel}" />
                        <ItemsControl x:Name="ReminderList" IsTabStop="False"
                                      AutomationProperties.Name="Reminders"
                                      AutomationProperties.AutomationId="ReminderList"
                                      ItemsSource="{x:Bind ViewModel.DetailReminders, Mode=OneTime}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="presentation:ReminderRowViewModel">
                                    <Grid Margin="0,2" ColumnSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource ReminderRowButton}"
                                                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneTime}"
                                                ToolTipService.ToolTip="Edit reminder"
                                                Click="OnEditReminderClick">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{x:Bind Text, Mode=OneTime}" />
                                                <TextBlock Style="{StaticResource SecondaryCaptionText}"
                                                           VerticalAlignment="Center" Text="past"
                                                           Visibility="{x:Bind IsPast, Mode=OneTime}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource SmallIconButton}"
                                                ToolTipService.ToolTip="Remove reminder"
                                                AutomationProperties.Name="{x:Bind RemoveName, Mode=OneTime}"
                                                Command="{x:Bind RemoveCommand, Mode=OneTime}">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="AddReminderButton" Margin="{StaticResource FieldMargin}"
                                AutomationProperties.Name="Add reminder"
                                AutomationProperties.AutomationId="AddReminderButton"
                                Click="OnAddReminderClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="Add reminder" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="ReminderErrorText" Style="{StaticResource FieldErrorText}"
                               Text="{x:Bind ViewModel.ReminderError, Mode=OneWay}"
                               Visibility="{x:Bind local:DetailPane.ShownWithText(ViewModel.ReminderError), Mode=OneWay, FallbackValue=Collapsed}" />
                    <Grid x:Name="SnoozeRow" Margin="{StaticResource FieldMargin}" ColumnSpacing="6"
                          Visibility="{x:Bind ViewModel.HasDetailSnooze, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SecondaryCaptionText}" VerticalAlignment="Center"
                                   Text="{x:Bind ViewModel.DetailSnooze, Mode=OneWay}" />
                        <Button Grid.Column="1" Content="Clear Snooze"
                                AutomationProperties.Name="Clear Snooze"
                                ToolTipService.ToolTip="Clear the Snooze; the planned Reminder fires again"
                                Command="{x:Bind ViewModel.ClearSnoozeCommand, Mode=OneTime}" />
                    </Grid>

                    <!-- Repeat: only once the Task has a Due date. -->
                    <StackPanel x:Name="RepeatSection" Visibility="{x:Bind ViewModel.HasDetailDue, Mode=OneWay}">
                        <TextBlock Text="Repeat" Style="{StaticResource FieldLabel}" />
                        <StackPanel Margin="{StaticResource FieldMargin}" Spacing="6">
                            <ComboBox x:Name="RepeatBox" MinWidth="160"
                                      AutomationProperties.Name="Repeat"
                                      ItemsSource="{x:Bind local:DetailPane.RepeatNames, Mode=OneTime}"
                                      SelectedIndex="{x:Bind local:DetailPane.RepeatIndex(Repeat.Preset), BindBack=SetRepeatIndex, Mode=TwoWay, FallbackValue=0}" />
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        Visibility="{x:Bind Repeat.HasInterval, Mode=OneWay}">
                                <TextBlock Text="Every" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                <TextBox Width="56" MaxLength="3"
                                         AutomationProperties.Name="Repeat every"
                                         ToolTipService.ToolTip="Every N days, weeks, months or years"
                                         Text="{x:Bind local:DetailPane.NumberText(Repeat.Interval), BindBack=SetInterval, Mode=TwoWay, FallbackValue='0'}" />
                                <TextBlock Style="{StaticResource SecondaryCaptionText}" VerticalAlignment="Center"
                                           Text="{x:Bind local:DetailPane.IntervalUnit(Repeat.Preset), Mode=OneWay, FallbackValue=''}" />
                            </StackPanel>
                            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="64"
                                                   Visibility="{x:Bind Repeat.HasDays, Mode=OneWay}">
                                <CheckBox Content="Mon" MinWidth="0" AutomationProperties.Name="Monday"
                                          IsChecked="{x:Bind Repeat.Monday, Mode=TwoWay}" />
                                <CheckBox Content="Tue" MinWidth="0" AutomationProperties.Name="Tuesday"
                                          IsChecked="{x:Bind Repeat.Tuesday, Mode=TwoWay}" />
                                <CheckBox Content="Wed" MinWidth="0" AutomationProperties.Name="Wednesday"
                                          IsChecked="{x:Bind Repeat.Wednesday, Mode=TwoWay}" />
                                <CheckBox Content="Thu" MinWidth="0" AutomationProperties.Name="Thursday"
                                          IsChecked="{x:Bind Repeat.Thursday, Mode=TwoWay}" />
                                <CheckBox Content="Fri" MinWidth="0" AutomationProperties.Name="Friday"
                                          IsChecked="{x:Bind Repeat.Friday, Mode=TwoWay}" />
                                <CheckBox Content="Sat" MinWidth="0" AutomationProperties.Name="Saturday"
                                          IsChecked="{x:Bind Repeat.Saturday, Mode=TwoWay}" />
                                <CheckBox Content="Sun" MinWidth="0" AutomationProperties.Name="Sunday"
                                          IsChecked="{x:Bind Repeat.Sunday, Mode=TwoWay}" />
                            </VariableSizedWrapGrid>
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        Visibility="{x:Bind Repeat.HasDayOfMonth, Mode=OneWay}">
                                <TextBlock Text="On day" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                <TextBox Width="56" MaxLength="2"
                                         AutomationProperties.Name="Day of month"
                                         ToolTipService.ToolTip="Day of the month (1-31; shorter months use their last day)"
                                         Text="{x:Bind local:DetailPane.NumberText(Repeat.DayOfMonth), BindBack=SetDayOfMonth, Mode=TwoWay, FallbackValue='0'}" />
                            </StackPanel>
                            <StackPanel Spacing="4" Visibility="{x:Bind Repeat.IsRepeating, Mode=OneWay}">
                                <CheckBox Content="Count from the completion date"
                                          AutomationProperties.Name="Repeat from the completion date"
                                          IsChecked="{x:Bind Repeat.RepeatFromCompletion, Mode=TwoWay}" />
                                <TextBlock Text="Ends on (optional)" Style="{StaticResource FieldLabel}" />
                                <CalendarDatePicker HorizontalAlignment="Stretch"
                                                    AutomationProperties.Name="Repeat end date"
                                                    Date="{x:Bind local:DetailPane.ToPickerDate(Repeat.EndDate), BindBack=SetRepeatEndDate, Mode=TwoWay, FallbackValue={x:Null}}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <!-- Outside the Repeat section, which hides without a Due date, so "needs a Due date" still shows. -->
                    <TextBlock x:Name="RepeatErrorText" Style="{StaticResource FieldErrorText}"
                               Text="{x:Bind ViewModel.RepeatError, Mode=OneWay}"
                               Visibility="{x:Bind local:DetailPane.ShownWithText(ViewModel.RepeatError), Mode=OneWay, FallbackValue=Collapsed}" />

                    <!-- Priority -->
                    <TextBlock Text="Priority" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="PriorityBox" Margin="{StaticResource FieldMargin}" MinWidth="160"
                              AutomationProperties.Name="Priority"
                              ItemsSource="{x:Bind local:DetailPane.PriorityNames, Mode=OneTime}"
                              SelectedIndex="{x:Bind local:DetailPane.PriorityIndex(ViewModel.DetailPriority), BindBack=SetPriorityIndex, Mode=TwoWay, FallbackValue=0}" />

                    <!-- List: the List the Task belongs to, as text with its dot or ring; it cannot be changed here. -->
                    <TextBlock Text="List" Style="{StaticResource FieldLabel}" />
                    <StackPanel x:Name="ListField" Orientation="Horizontal" Spacing="8" Margin="{StaticResource FieldMargin}"
                                AutomationProperties.Name="List">
                        <Grid Width="10" Height="10" VerticalAlignment="Center">
                            <Ellipse Fill="{x:Bind local:TaskRow.StripeBrush(ViewModel.DetailTask.ListColorHex), Mode=OneWay, FallbackValue={x:Null}}" />
                            <Ellipse StrokeThickness="1.5" Stroke="{ThemeResource ListStripeBrush}"
                                     Visibility="{x:Bind local:DetailPane.ShownWithoutColour(ViewModel.DetailTask.HasListColor), Mode=OneWay, FallbackValue=Visible}" />
                        </Grid>
                        <TextBlock Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis"
                                   Text="{x:Bind ViewModel.DetailTask.ListName, Mode=OneWay, FallbackValue=''}" />
                    </StackPanel>

                    <!-- Tags: a chip per Tag, whose own quiet button removes it, and a box to add one. -->
                    <TextBlock Text="Tags" Style="{StaticResource FieldLabel}" />
                    <ItemsControl x:Name="TagChips" IsTabStop="False"
                                  AutomationProperties.Name="Task tags"
                                  ItemsSource="{x:Bind ViewModel.DetailTask.Tags, Mode=OneWay, FallbackValue={x:Null}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:WrapPanel HorizontalSpacing="4" VerticalSpacing="4" Margin="0,0,0,4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="tags:Tag">
                                <Border Style="{StaticResource DetailTagChip}">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock Style="{StaticResource DetailTagChipText}"
                                                   Text="{x:Bind local:TaskRow.Hash(Name), Mode=OneTime, FallbackValue='#'}" />
                                        <Button Style="{StaticResource TagRemoveButton}"
                                                ToolTipService.ToolTip="Remove tag"
                                                AutomationProperties.Name="{x:Bind local:DetailPane.RemoveTagName(Name), Mode=OneTime, FallbackValue='Remove #'}"
                                                Click="OnRemoveTagClick">
                                            <FontIcon Glyph="&#xE711;" FontSize="8" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="{StaticResource FieldMargin}" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewTagBox" PlaceholderText="Add a tag"
                                 AutomationProperties.Name="New tag name"
                                 AutomationProperties.AutomationId="NewTagBox"
                                 Text="{x:Bind ViewModel.NewTagName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnAddBoxKeyDown" />
                        <Button Grid.Column="1" Content="Add tag"
                                Command="{x:Bind ViewModel.AddTagCommand, Mode=OneTime}" />
                    </Grid>

                    <!-- Notes -->
                    <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="DetailNotesBox" Height="140" Margin="{StaticResource FieldMargin}"
                             AcceptsReturn="True" TextWrapping="Wrap" MaxLength="10000"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Task notes"
                             AutomationProperties.AutomationId="DetailNotesBox"
                             Text="{x:Bind ViewModel.DetailNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Content="Delete Task" Style="{StaticResource QuietDangerButton}"
                            AutomationProperties.Name="Delete Task"
                            Command="{x:Bind ViewModel.DeleteDetailTaskCommand, Mode=OneTime}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
