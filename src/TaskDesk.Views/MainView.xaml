<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TaskDesk.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Quick add (the start-up focus target) over the Task list area (TaskListView, added in code). -->
    <Grid x:Name="RootGrid" Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBox x:Name="QuickAddBox"
                 AutomationProperties.AutomationId="QuickAddBox"
                 AutomationProperties.Name="Quick add"
                 PlaceholderText="{x:Bind ViewModel.QuickAddTarget, Mode=OneWay}"
                 Text="{x:Bind ViewModel.QuickAddTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </Grid>
</UserControl>
