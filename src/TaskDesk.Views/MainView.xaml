<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TaskDesk.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskDesk.Views"
    xmlns:presentation="using:TaskDesk.Presentation"
    KeyboardAcceleratorPlacementMode="Hidden"
    KeyDown="OnKeyDown">
    <!-- Ctrl+F searches and Ctrl+N goes to quick add, from anywhere in the window. -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnAcceleratorInvoked" />
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnAcceleratorInvoked" />
    </UserControl.KeyboardAccelerators>

    <!-- The list header (heading, Filter, search, Filter bar, quick add, empty state) over the Task
         list area (TaskListView, added in code) and "Load more completed". -->
    <Grid x:Name="RootGrid" Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="ListHeader" Spacing="8">
            <!-- Shown when Reminders fall back to tray balloons, until dismissed. -->
            <InfoBar x:Name="NotificationBanner" Severity="Warning" IsClosable="True"
                     AutomationProperties.Name="Notifications unavailable"
                     IsOpen="{x:Bind ViewModel.HasNotificationBanner, Mode=OneWay}"
                     Message="{x:Bind ViewModel.NotificationBanner, Mode=OneWay}"
                     CloseButtonCommand="{x:Bind ViewModel.DismissNotificationBannerCommand, Mode=OneTime}" />
            <Grid x:Name="HeadingRow" ColumnSpacing="8" MinHeight="{ThemeResource TextControlThemeMinHeight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="SearchColumn" Width="280" />
                </Grid.ColumnDefinitions>
                <!-- The name fits first: search takes its 280 px, the name gets the rest and ends with an ellipsis.
                     A long name trims down to 160 px before search shrinks (to its 160 px); a name narrower than 160 px
                     is never trimmed. A Grid cannot say this with star weights and Min/MaxWidth (it keeps search at
                     its maximum and overflows), so FitHeadingRow sets SearchColumn's width. Filter sits directly left
                     of search and never shrinks. While the detail pane overlays the page (1100 px or less) Filter and
                     search are collapsed, and the row's MinHeight (the height of search) keeps quick add and the list
                     in place. Fluent's subtitle style wraps; the heading stays on one line. -->
                <TextBlock x:Name="PageHeading" Style="{StaticResource SubtitleText}" VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="PageHeading"
                           Text="{x:Bind ViewModel.PageHeading, Mode=OneWay}"
                           ToolTipService.ToolTip="{x:Bind ViewModel.PageHeading, Mode=OneWay}" />
                <local:CommandToggleButton x:Name="FilterButton" Grid.Column="1" VerticalAlignment="Center"
                                           Visibility="{x:Bind ViewModel.HasHeadingTools, Mode=OneWay}"
                                           AutomationProperties.Name="Filter"
                                           AutomationProperties.AutomationId="FilterButton"
                                           ToolTipService.ToolTip="Show or hide the Filters"
                                           IsChecked="{x:Bind ViewModel.IsFilterBarShown, Mode=OneWay}"
                                           Command="{x:Bind ViewModel.ToggleFilterBarCommand, Mode=OneTime}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="FilterIcon" Glyph="&#xE71C;" FontSize="16" />
                        <TextBlock x:Name="FilterLabel" Text="Filter" VerticalAlignment="Center" />
                    </StackPanel>
                </local:CommandToggleButton>
                <TextBox x:Name="SearchBox" Grid.Column="2" VerticalAlignment="Center"
                         Visibility="{x:Bind ViewModel.HasHeadingTools, Mode=OneWay}"
                         AutomationProperties.Name="Search (Ctrl+F)"
                         AutomationProperties.AutomationId="SearchBox"
                         ToolTipService.ToolTip="Search (Ctrl+F). Esc clears."
                         PlaceholderText="{x:Bind ViewModel.SearchScope, Mode=OneWay}"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <!-- Wraps like the WPF Filter bar: the Tag chips, as one block, go to the next line when they do not
                 fit after the other Filters, and wrap among themselves within the bar's width. -->
            <local:WrapPanel x:Name="FilterBar" HorizontalSpacing="6" VerticalSpacing="6"
                             AutomationProperties.Name="Filters" AutomationProperties.AutomationId="FilterBar"
                             Visibility="{x:Bind ViewModel.IsFilterBarShown, Mode=OneWay}">
                <ComboBox x:Name="PriorityFilterBox" Width="170"
                          AutomationProperties.Name="Priority filter"
                          SelectionChanged="OnPriorityFilterChanged" />
                <local:CommandToggleButton Content="Has due"
                                           AutomationProperties.Name="Has due filter"
                                           IsChecked="{x:Bind ViewModel.HasDueFilter, Mode=OneWay}"
                                           Command="{x:Bind ViewModel.ToggleHasDueFilterCommand, Mode=OneTime}" />
                <local:CommandToggleButton Content="Has reminder"
                                           AutomationProperties.Name="Has reminder filter"
                                           IsChecked="{x:Bind ViewModel.HasReminderFilter, Mode=OneWay}"
                                           Command="{x:Bind ViewModel.ToggleHasReminderFilterCommand, Mode=OneTime}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.FilterTagChips, Mode=OneTime}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <local:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="presentation:FilterTagChip">
                            <local:CommandToggleButton
                                                       AutomationProperties.Name="{x:Bind local:MainView.TagText(Tag), Mode=OneTime, FallbackValue=''}"
                                                       Content="{x:Bind local:MainView.TagText(Tag), Mode=OneTime, FallbackValue=''}"
                                                       IsChecked="{x:Bind IsSelected, Mode=OneTime}"
                                                       CommandParameter="{x:Bind Tag, Mode=OneTime}"
                                                       Loaded="OnFilterTagChipLoaded" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Clear filters"
                        Command="{x:Bind ViewModel.ClearAllFiltersCommand, Mode=OneTime}"
                        Visibility="{x:Bind ViewModel.HasFilter, Mode=OneWay}" />
            </local:WrapPanel>
            <TextBox x:Name="QuickAddBox"
                     AutomationProperties.AutomationId="QuickAddBox"
                     AutomationProperties.Name="Quick add"
                     PlaceholderText="{x:Bind ViewModel.QuickAddTarget, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.ShowsQuickAdd, Mode=OneWay}"
                     Text="{x:Bind ViewModel.QuickAddTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnQuickAddKeyDown" />
            <!-- Empty and no-result states: plain text, no box or outline. -->
            <StackPanel x:Name="EmptyState" Spacing="8" AutomationProperties.AutomationId="EmptyState"
                        Visibility="{x:Bind ViewModel.HasEmptyMessage, Mode=OneWay}">
                <TextBlock x:Name="EmptyMessage" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="EmptyMessage"
                           Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" />
                <Button x:Name="ClearSearchButton" Content="Clear search" Padding="8,2"
                        AutomationProperties.AutomationId="ClearSearchButton"
                        Command="{x:Bind ViewModel.ClearSearchCommand, Mode=OneTime}"
                        Visibility="{x:Bind ViewModel.ShowClearSearch, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
        <Button x:Name="LoadMoreCompletedButton" Grid.Row="2" Content="Load more completed tasks" Padding="8,2"
                AutomationProperties.AutomationId="LoadMoreCompletedButton"
                Command="{x:Bind ViewModel.LoadMoreCompletedCommand, Mode=OneTime}"
                Visibility="{x:Bind ViewModel.HasMoreCompleted, Mode=OneWay}" />
    </Grid>
</UserControl>
