<?xml version="1.0" encoding="utf-8"?>
<!--
    The sidebar as a native NavigationView: the Smart Views with their icons and open-Task counts, and the page
    (MainView) as its content. Wide windows show the full pane (Left); below 900 px it is the icon rail
    (LeftCompact), whose hamburger opens the full pane as an overlay. The PropertySizer at the content's left
    edge is the sidebar splitter; it resizes OpenPaneLength, which the shell saves (MainWindow.MeasurePaneWidths).
-->
<UserControl
    x:Class="TaskDesk.Views.NavigationPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskDesk.Views"
    xmlns:presentation="using:TaskDesk.Presentation"
    xmlns:tags="using:TaskDesk.Core.Tags"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls">
    <UserControl.Resources>
        <!-- A count in soft ink: the inverse text colour reads on it at body-text contrast (Fluent's neutral
             InfoBadge fill is too light for its text). -->
        <Style x:Key="SmartViewCountBadge" TargetType="InfoBadge">
            <Setter Property="Background" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorInverseBrush}" />
        </Style>
        <!-- Overdue's count is red. -->
        <Style x:Key="SmartViewOverdueBadge" TargetType="InfoBadge">
            <Setter Property="Background" Value="{ThemeResource OverdueBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
        <!-- A sidebar row: no minimum width (the rail is 48 px) and its content across the row. -->
        <Style x:Key="SidebarListItem" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,0,12,0" />
        </Style>
        <!-- The rail's List row: the initial's ring centred in the 48 px rail, like the Smart Views' icons. -->
        <Style x:Key="RailListItem" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="SidebarSectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongText}">
            <Setter Property="Margin" Value="16,12,0,4" />
        </Style>

        <!-- A List: its colour dot (a hollow ring for none), its name and its open count. The dot sits in a 24 px
             icon column, as the Tags' "#" does, so the names line up. -->
        <DataTemplate x:Key="ListRowTemplate" x:DataType="presentation:ListItemViewModel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="10" Height="10" HorizontalAlignment="Left"
                         Fill="{x:Bind local:NavigationPane.ColourBrush(ColorHex), Mode=OneWay}"
                         Visibility="{x:Bind local:NavigationPane.ShownWithColour(ColorHex), Mode=OneWay}" />
                <Ellipse Width="10" Height="10" HorizontalAlignment="Left" StrokeThickness="1.5"
                         Stroke="{ThemeResource ListStripeBrush}"
                         Visibility="{x:Bind local:NavigationPane.ShownWithoutColour(ColorHex), Mode=OneWay}" />
                <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                           Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                <InfoBadge Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource SmartViewCountBadge}"
                           Value="{x:Bind OpenTaskCount, Mode=OneWay}"
                           Visibility="{x:Bind local:NavigationPane.ShownAboveZero(OpenTaskCount), Mode=OneWay}" />
            </Grid>
        </DataTemplate>
        <!-- A List in the rail: its initial inside a ring of its colour (the stripe colour for none). -->
        <DataTemplate x:Key="RailListRowTemplate" x:DataType="presentation:ListItemViewModel">
            <Grid Width="24" Height="24" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}">
                <Ellipse StrokeThickness="1.5"
                         Stroke="{x:Bind local:NavigationPane.ColourBrush(ColorHex), Mode=OneWay}"
                         Visibility="{x:Bind local:NavigationPane.ShownWithColour(ColorHex), Mode=OneWay}" />
                <Ellipse StrokeThickness="1.5" Stroke="{ThemeResource ListStripeBrush}"
                         Visibility="{x:Bind local:NavigationPane.ShownWithoutColour(ColorHex), Mode=OneWay}" />
                <TextBlock Style="{StaticResource CaptionText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="{x:Bind Initial, Mode=OneWay}" />
            </Grid>
        </DataTemplate>
        <!-- A Tag: "#" in the icon column, then its name. -->
        <DataTemplate x:Key="TagRowTemplate" x:DataType="tags:Tag">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center" Text="#"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                           Text="{x:Bind Name, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <!-- Shared by every List row (right click, Shift+F10 or the Menu key); Opening finds the row's List. -->
        <MenuFlyout x:Key="ListMenu" Opening="OnListMenuOpening">
            <MenuFlyoutItem Text="Rename" Click="OnRenameClick" />
            <MenuFlyoutSubItem Text="Colour">
                <MenuFlyoutItem Text="None" Tag="" Click="OnColourClick" />
                <MenuFlyoutItem Text="Red" Tag="#D13438" Click="OnColourClick" />
                <MenuFlyoutItem Text="Orange" Tag="#F7630C" Click="OnColourClick" />
                <MenuFlyoutItem Text="Yellow" Tag="#FFB900" Click="OnColourClick" />
                <MenuFlyoutItem Text="Green" Tag="#107C10" Click="OnColourClick" />
                <MenuFlyoutItem Text="Blue" Tag="#0078D4" Click="OnColourClick" />
                <MenuFlyoutItem Text="Purple" Tag="#744DA9" Click="OnColourClick" />
            </MenuFlyoutSubItem>
            <MenuFlyoutItem Text="Delete" Click="OnDeleteListClick" />
        </MenuFlyout>
        <MenuFlyout x:Key="TagMenu" Opening="OnTagMenuOpening">
            <MenuFlyoutItem Text="Delete" Click="OnDeleteTagClick" />
        </MenuFlyout>
    </UserControl.Resources>
    <NavigationView
        x:Name="Pane"
        x:FieldModifier="public"
        PaneDisplayMode="Left"
        IsPaneOpen="True"
        IsPaneToggleButtonVisible="False"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        AlwaysShowHeader="False"
        SelectionChanged="OnSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="TodayItem" Content="Today" ToolTipService.ToolTip="Today (Ctrl+1)"
                                AutomationProperties.Name="Today" AutomationProperties.AutomationId="SmartViewToday"
                                KeyboardAcceleratorPlacementMode="Hidden">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE161;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge Style="{StaticResource SmartViewCountBadge}"
                               Value="{x:Bind ViewModel.TodayCount, Mode=OneWay}"
                               Visibility="{x:Bind local:NavigationPane.ShownAboveZero(ViewModel.TodayCount), Mode=OneWay}" />
                </NavigationViewItem.InfoBadge>
                <NavigationViewItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnAcceleratorInvoked" />
                </NavigationViewItem.KeyboardAccelerators>
            </NavigationViewItem>
            <NavigationViewItem x:Name="UpcomingItem" Content="Upcoming" ToolTipService.ToolTip="Upcoming (Ctrl+2)"
                                AutomationProperties.Name="Upcoming" AutomationProperties.AutomationId="SmartViewUpcoming"
                                KeyboardAcceleratorPlacementMode="Hidden">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE787;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge Style="{StaticResource SmartViewCountBadge}"
                               Value="{x:Bind ViewModel.UpcomingCount, Mode=OneWay}"
                               Visibility="{x:Bind local:NavigationPane.ShownAboveZero(ViewModel.UpcomingCount), Mode=OneWay}" />
                </NavigationViewItem.InfoBadge>
                <NavigationViewItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnAcceleratorInvoked" />
                </NavigationViewItem.KeyboardAccelerators>
            </NavigationViewItem>
            <NavigationViewItem x:Name="OverdueItem" Content="Overdue" ToolTipService.ToolTip="Overdue (Ctrl+3)"
                                AutomationProperties.Name="Overdue" AutomationProperties.AutomationId="SmartViewOverdue"
                                KeyboardAcceleratorPlacementMode="Hidden">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7BA;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge Style="{StaticResource SmartViewOverdueBadge}"
                               Value="{x:Bind ViewModel.OverdueCount, Mode=OneWay}"
                               Visibility="{x:Bind local:NavigationPane.ShownAboveZero(ViewModel.OverdueCount), Mode=OneWay}" />
                </NavigationViewItem.InfoBadge>
                <NavigationViewItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="OnAcceleratorInvoked" />
                </NavigationViewItem.KeyboardAccelerators>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AllItem" Content="All" ToolTipService.ToolTip="All (Ctrl+4)"
                                AutomationProperties.Name="All" AutomationProperties.AutomationId="SmartViewAll"
                                KeyboardAcceleratorPlacementMode="Hidden">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8FD;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge Style="{StaticResource SmartViewCountBadge}"
                               Value="{x:Bind ViewModel.AllCount, Mode=OneWay}"
                               Visibility="{x:Bind local:NavigationPane.ShownAboveZero(ViewModel.AllCount), Mode=OneWay}" />
                </NavigationViewItem.InfoBadge>
                <NavigationViewItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="OnAcceleratorInvoked" />
                </NavigationViewItem.KeyboardAccelerators>
            </NavigationViewItem>
            <NavigationViewItem x:Name="CompletedItem" Content="Completed" ToolTipService.ToolTip="Completed (Ctrl+5)"
                                AutomationProperties.Name="Completed" AutomationProperties.AutomationId="SmartViewCompleted"
                                KeyboardAcceleratorPlacementMode="Hidden">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE930;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="OnAcceleratorInvoked" />
                </NavigationViewItem.KeyboardAccelerators>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <!-- Lists, "+ New List" and Tags: one scroll area right under the Smart Views (the pane footer, whose row
             takes the rest of the pane; see FitFooterUnderMenuItems). Native lists keep the UI tests' ids and give
             drag reordering and the rows' context menus. In the rail the Lists show their initials and the Tags
             move behind the # button. -->
        <NavigationView.PaneFooter>
            <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Rectangle Height="1" Margin="12,4,12,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock x:Name="ListsHeader" Style="{StaticResource SidebarSectionHeader}" Text="Lists" />
                    <ListView x:Name="ListsList"
                              ItemContainerStyle="{StaticResource SidebarListItem}"
                              ItemTemplate="{StaticResource ListRowTemplate}"
                              SelectionMode="Single" CanDragItems="True" AllowDrop="True"
                              ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="Lists" AutomationProperties.AutomationId="ListsList"
                              ContainerContentChanging="OnListContainerContentChanging"
                              SelectionChanged="OnListSelectionChanged" KeyDown="OnListKeyDown"
                              DragItemsStarting="OnListDragStarting" DragItemsCompleted="OnListDragCompleted"
                              DragOver="OnListDragOver" Drop="OnListDrop" />
                    <StackPanel x:Name="NewListArea">
                        <!-- Takes no room until there is an error, so "+ New List" sits right under the last List. -->
                        <TextBlock Style="{StaticResource CaptionText}" Foreground="{ThemeResource OverdueBrush}"
                                   TextWrapping="Wrap" Margin="16,4,12,0"
                                   Text="{x:Bind Lists.ErrorMessage, Mode=OneWay}"
                                   Visibility="{x:Bind local:NavigationPane.ShownWithText(Lists.ErrorMessage), Mode=OneWay}" />
                        <Button x:Name="NewListButton" Style="{StaticResource SubtleButtonStyle}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="4,0,4,0"
                                Content="+ New List" AutomationProperties.Name="New list"
                                AutomationProperties.AutomationId="NewListButton" Click="OnNewListClick" />
                        <TextBox x:Name="NewListBox" Visibility="Collapsed" Margin="8,2,8,0"
                                 AutomationProperties.Name="New list name" AutomationProperties.AutomationId="NewListBox"
                                 Text="{x:Bind Lists.NewListName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnNewListKeyDown" LostFocus="OnNewListLostFocus" />
                    </StackPanel>
                    <StackPanel x:Name="TagsSection" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SidebarSectionHeader}" Text="Tags" />
                        <ListView x:Name="TagList"
                                  ItemsSource="{x:Bind ViewModel.Tags, Mode=OneTime}"
                                  ItemContainerStyle="{StaticResource SidebarListItem}"
                                  ItemTemplate="{StaticResource TagRowTemplate}"
                                  SelectionMode="Single"
                                  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="Tags" AutomationProperties.AutomationId="TagList"
                                  ContainerContentChanging="OnTagContainerContentChanging"
                                  SelectionChanged="OnTagSelectionChanged" KeyDown="OnTagKeyDown" />
                    </StackPanel>
                    <!-- The rail's Tags: a # button whose flyout lists them. -->
                    <Button x:Name="RailTagsButton" Visibility="Collapsed" Style="{StaticResource SubtleButtonStyle}"
                            HorizontalAlignment="Center" Width="40" Height="36" Margin="0,4,0,0" Content="#"
                            ToolTipService.ToolTip="Tags"
                            AutomationProperties.Name="Tags" AutomationProperties.AutomationId="RailTagsButton">
                        <Button.Flyout>
                            <Flyout x:Name="TagsFlyout" Placement="RightEdgeAlignedTop">
                                <ListView x:Name="RailTagList" MinWidth="160"
                                          ItemsSource="{x:Bind ViewModel.Tags, Mode=OneTime}"
                                          ItemContainerStyle="{StaticResource SidebarListItem}"
                                          ItemTemplate="{StaticResource TagRowTemplate}"
                                          SelectionMode="Single"
                                          AutomationProperties.Name="Tags" AutomationProperties.AutomationId="RailTagList"
                                          ContainerContentChanging="OnTagContainerContentChanging"
                                          SelectionChanged="OnTagSelectionChanged" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </NavigationView.PaneFooter>
        <Grid>
            <Border x:Name="PageHost" />
            <!-- The sidebar splitter, on the content's left edge; collapsed while the sidebar is the rail. -->
            <ctk:PropertySizer x:Name="SidebarSplitter"
                               HorizontalAlignment="Left"
                               Width="12"
                               AutomationProperties.AutomationId="SidebarSplitter"
                               AutomationProperties.Name="Resize sidebar"
                               Binding="{x:Bind Pane.OpenPaneLength, Mode=TwoWay}"
                               Minimum="{x:Bind local:NavigationPane.MinimumWidth, Mode=OneTime}"
                               Maximum="{x:Bind local:NavigationPane.MaximumWidth, Mode=OneTime}" />
        </Grid>
    </NavigationView>
</UserControl>
