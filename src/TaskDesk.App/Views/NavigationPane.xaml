<UserControl x:Class="TaskDesk.App.Views.NavigationPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tasks="clr-namespace:TaskDesk.Core.Tasks;assembly=TaskDesk.Core">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Context menus are resources, not inline in the Style setters: WPF cannot hook up event handlers
             on elements defined inside a Setter. x:Shared="False" gives every row its own menu. -->
        <ContextMenu x:Key="ListContextMenu" x:Shared="False" Opened="OnMenuOpened">
            <MenuItem Header="Rename" Click="OnRenameClick" />
            <MenuItem Header="Colour">
                <MenuItem Header="None" Tag="" Click="OnColorClick" />
                <MenuItem Header="Red" Tag="#D13438" Click="OnColorClick" />
                <MenuItem Header="Orange" Tag="#F7630C" Click="OnColorClick" />
                <MenuItem Header="Yellow" Tag="#FFB900" Click="OnColorClick" />
                <MenuItem Header="Green" Tag="#107C10" Click="OnColorClick" />
                <MenuItem Header="Blue" Tag="#0078D4" Click="OnColorClick" />
                <MenuItem Header="Purple" Tag="#744DA9" Click="OnColorClick" />
            </MenuItem>
            <MenuItem Header="Delete" Tag="delete" Click="OnDeleteClick" />
        </ContextMenu>
        <ContextMenu x:Key="TagContextMenu" x:Shared="False">
            <MenuItem Header="Delete" Click="OnDeleteTagClick" />
        </ContextMenu>

        <Style x:Key="ListItemContainer" TargetType="ListBoxItem" BasedOn="{StaticResource SidebarListBoxItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="ContextMenu" Value="{StaticResource ListContextMenu}" />
        </Style>

        <Style x:Key="RailListItemContainer" TargetType="ListBoxItem" BasedOn="{StaticResource RailListBoxItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
            <Setter Property="ContextMenu" Value="{StaticResource ListContextMenu}" />
        </Style>

        <Style x:Key="TagItemContainer" TargetType="ListBoxItem" BasedOn="{StaticResource SidebarListBoxItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="ContextMenu" Value="{StaticResource TagContextMenu}" />
        </Style>
    </UserControl.Resources>
    <!-- Smart Views, Lists and Tags in the Windows Settings style: one list per section, all on the
         sidebar's own background. Rename, Colour and Delete are on the context menu of each List or Tag. -->
    <Grid>
    <Grid x:Name="FullHost">
    <Grid x:Name="FullSidebar">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ListBox x:Name="SmartViewList" Grid.Row="0" Style="{StaticResource SidebarListBox}"
                 ItemContainerStyle="{StaticResource SidebarListBoxItem}"
                 AutomationProperties.Name="Smart Views" AutomationProperties.AutomationId="SmartViewList"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 SelectionChanged="OnSmartViewSelectionChanged">
            <ListBoxItem Tag="{x:Static tasks:SmartView.Today}" ToolTip="Today (Ctrl+1)"
                         AutomationProperties.Name="Today" AutomationProperties.AutomationId="SmartViewToday">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource SidebarCount}" Text="{Binding TodayCount}" />
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource SidebarIcon}" Text="&#xE161;" />
                    <TextBlock Style="{StaticResource BodyText}" Text="Today" VerticalAlignment="Center" />
                </DockPanel>
            </ListBoxItem>
            <ListBoxItem Tag="{x:Static tasks:SmartView.Upcoming}" ToolTip="Upcoming (Ctrl+2)"
                         AutomationProperties.Name="Upcoming" AutomationProperties.AutomationId="SmartViewUpcoming">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource SidebarCount}" Text="{Binding UpcomingCount}" />
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource SidebarIcon}" Text="&#xE787;" />
                    <TextBlock Style="{StaticResource BodyText}" Text="Upcoming" VerticalAlignment="Center" />
                </DockPanel>
            </ListBoxItem>
            <ListBoxItem Tag="{x:Static tasks:SmartView.Overdue}" ToolTip="Overdue (Ctrl+3)"
                         AutomationProperties.Name="Overdue" AutomationProperties.AutomationId="SmartViewOverdue">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource SidebarBadge}"
                            Visibility="{Binding HasOverdueCount, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding OverdueCount}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                   AutomationProperties.Name="Overdue count" />
                    </Border>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource SidebarIcon}" Text="&#xE7BA;" />
                    <TextBlock Style="{StaticResource BodyText}" Text="Overdue" VerticalAlignment="Center" />
                </DockPanel>
            </ListBoxItem>
            <ListBoxItem Tag="{x:Static tasks:SmartView.All}" ToolTip="All (Ctrl+4)"
                         AutomationProperties.Name="All" AutomationProperties.AutomationId="SmartViewAll">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource SidebarCount}" Text="{Binding AllCount}" />
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource SidebarIcon}" Text="&#xE8FD;" />
                    <TextBlock Style="{StaticResource BodyText}" Text="All" VerticalAlignment="Center" />
                </DockPanel>
            </ListBoxItem>
            <ListBoxItem Tag="{x:Static tasks:SmartView.Completed}" ToolTip="Completed (Ctrl+5)"
                         AutomationProperties.Name="Completed" AutomationProperties.AutomationId="SmartViewCompleted">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource SidebarIcon}" Text="&#xE930;" />
                    <TextBlock Style="{StaticResource BodyText}" Text="Completed" VerticalAlignment="Center" />
                </DockPanel>
            </ListBoxItem>
        </ListBox>

        <Border Grid.Row="1" Style="{StaticResource SidebarDivider}" />

        <!-- Everything under the Smart Views scrolls together: Lists, "+ New List", then Tags. -->
        <ScrollViewer x:Name="SidebarScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel>
        <StackPanel x:Name="ListsPanel" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource SidebarSectionHeader}" Text="Lists" />
            <ListBox x:Name="ListsBox" ItemsSource="{Binding Lists}" AllowDrop="True"
                     Style="{StaticResource SidebarListBox}" ItemContainerStyle="{StaticResource ListItemContainer}"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Lists" AutomationProperties.AutomationId="ListsList"
                     PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove"
                     PreviewKeyDown="OnListKeyDown" SelectionChanged="OnListSelectionChanged"
                     PreviewMouseWheel="OnNestedListMouseWheel" Drop="OnListDrop">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True" Background="Transparent">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource SidebarCount}"
                                       Text="{Binding OpenTaskCount}" />
                            <Grid DockPanel.Dock="Left" Width="24" VerticalAlignment="Center">
                                <!-- A coloured dot; a hollow ring when the List has no colour. -->
                                <Ellipse Width="10" Height="10"
                                         Fill="{Binding ColorHex, TargetNullValue=Transparent, FallbackValue=Transparent}" />
                                <Ellipse Width="10" Height="10" StrokeThickness="1.5"
                                         Stroke="{DynamicResource ListStripeBrush}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ColorHex}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                            <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                       Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel>
                <!-- Takes no room until there is an error, so "+ New List" sits right under the last List. -->
                <TextBlock Foreground="{DynamicResource OverdueBrush}" TextWrapping="Wrap" Margin="8,4,8,0"
                           Text="{Binding ErrorMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button x:Name="NewListButton" Style="{StaticResource SidebarActionButton}"
                        Content="+ New List" AutomationProperties.Name="New list"
                        AutomationProperties.AutomationId="NewListButton" Click="OnNewListClick" />
                <TextBox x:Name="NewListBox" Visibility="Collapsed" Margin="0,2,0,0"
                         AutomationProperties.Name="New list name" AutomationProperties.AutomationId="NewListBox"
                         Text="{Binding NewListName, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="OnNewListKeyDown" LostKeyboardFocus="OnNewListLostFocus">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding CreateListCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </StackPanel>
        </StackPanel>

        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tags.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Style="{StaticResource SidebarSectionHeader}" Text="Tags" />
            <ListBox x:Name="TagList" ItemsSource="{Binding Tags}" Style="{StaticResource SidebarListBox}"
                     ItemContainerStyle="{StaticResource TagItemContainer}"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Tags" AutomationProperties.AutomationId="TagList"
                     PreviewKeyDown="OnTagKeyDown" SelectionChanged="OnTagSelectionChanged"
                     PreviewMouseWheel="OnNestedListMouseWheel">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- "#" sits in the icon column, as the dot does for a List, so the names line up. -->
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Width="24" TextAlignment="Center" VerticalAlignment="Center"
                                       Style="{StaticResource BodyText}" Text="#"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                       Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Grid>
    </Grid>

    <!-- The icon rail, shown instead of the full sidebar when the window is narrower than 900 px
         (SetRail). Same Smart Views, Lists and Tags, as icons only. -->
    <Grid x:Name="RailPanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button x:Name="ExpandButton" Grid.Row="0" Style="{StaticResource SidebarActionButton}"
                HorizontalContentAlignment="Center" Margin="0,0,0,4" ToolTip="Show the sidebar"
                AutomationProperties.Name="Show sidebar" AutomationProperties.AutomationId="SidebarExpandButton"
                Click="OnExpandClick">
            <TextBlock Style="{StaticResource SidebarIcon}" Text="&#xE700;" HorizontalAlignment="Center" />
        </Button>
        <ListBox x:Name="RailSmartViewList" Grid.Row="1" Style="{StaticResource SidebarListBox}"
                 ItemContainerStyle="{StaticResource RailListBoxItem}"
                 AutomationProperties.Name="Smart Views" AutomationProperties.AutomationId="RailSmartViewList"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 SelectionChanged="OnSmartViewSelectionChanged">
            <ListBoxItem Tag="{x:Static tasks:SmartView.Today}" ToolTip="Today (Ctrl+1)"
                         AutomationProperties.Name="Today" AutomationProperties.AutomationId="RailSmartViewToday">
                <Grid>
                    <TextBlock Style="{StaticResource SidebarIcon}" Text="&#xE161;" HorizontalAlignment="Center" />
                    <Border Style="{StaticResource RailBadge}" Tag="{Binding TodayCount}">
                        <TextBlock Style="{StaticResource RailBadgeText}" Text="{Binding TodayCount}" />
                    </Border>
                </Grid>
            </ListBoxItem>
            <ListBoxItem Tag="{x:Static tasks:SmartView.Upcoming}" ToolTip="Upcoming (Ctrl+2)"
                         AutomationProperties.Name="Upcoming" AutomationProperties.AutomationId="RailSmartViewUpcoming">
                <Grid>
                    <TextBlock Style="{StaticResource SidebarIcon}" Text="&#xE787;" HorizontalAlignment="Center" />
                    <Border Style="{StaticResource RailBadge}" Tag="{Binding UpcomingCount}">
                        <TextBlock Style="{StaticResource RailBadgeText}" Text="{Binding UpcomingCount}" />
                    </Border>
                </Grid>
            </ListBoxItem>
            <ListBoxItem Tag="{x:Static tasks:SmartView.Overdue}" ToolTip="Overdue (Ctrl+3)"
                         AutomationProperties.Name="Overdue" AutomationProperties.AutomationId="RailSmartViewOverdue">
                <Grid>
                    <TextBlock Style="{StaticResource SidebarIcon}" Text="&#xE7BA;" HorizontalAlignment="Center" />
                    <Border Style="{StaticResource RailBadgeOverdue}"
                            Visibility="{Binding HasOverdueCount, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding OverdueCount}"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                </Grid>
            </ListBoxItem>
            <ListBoxItem Tag="{x:Static tasks:SmartView.All}" ToolTip="All (Ctrl+4)"
                         AutomationProperties.Name="All" AutomationProperties.AutomationId="RailSmartViewAll">
                <Grid>
                    <TextBlock Style="{StaticResource SidebarIcon}" Text="&#xE8FD;" HorizontalAlignment="Center" />
                    <Border Style="{StaticResource RailBadge}" Tag="{Binding AllCount}">
                        <TextBlock Style="{StaticResource RailBadgeText}" Text="{Binding AllCount}" />
                    </Border>
                </Grid>
            </ListBoxItem>
            <ListBoxItem Tag="{x:Static tasks:SmartView.Completed}" ToolTip="Completed (Ctrl+5)"
                         AutomationProperties.Name="Completed" AutomationProperties.AutomationId="RailSmartViewCompleted">
                <Grid>
                    <TextBlock Style="{StaticResource SidebarIcon}" Text="&#xE930;" HorizontalAlignment="Center" />
                </Grid>
            </ListBoxItem>
        </ListBox>
        <Border Grid.Row="2" Style="{StaticResource SidebarDivider}" />
        <ListBox x:Name="RailListsBox" Grid.Row="3" Style="{StaticResource SidebarListBox}"
                 ItemContainerStyle="{StaticResource RailListItemContainer}"
                 AutomationProperties.Name="Lists" AutomationProperties.AutomationId="RailListsList"
                 PreviewKeyDown="OnListKeyDown" SelectionChanged="OnListSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="24" HorizontalAlignment="Center" Background="Transparent">
                        <Ellipse Width="10" Height="10"
                                 Fill="{Binding ColorHex, TargetNullValue=Transparent, FallbackValue=Transparent}" />
                        <Ellipse Width="10" Height="10" StrokeThickness="1.5"
                                 Stroke="{DynamicResource ListStripeBrush}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ColorHex}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="RailTagsButton" Grid.Row="4" HorizontalContentAlignment="Center" ToolTip="Tags"
                AutomationProperties.Name="Tags" AutomationProperties.AutomationId="RailTagsButton"
                Click="OnRailTagsClick">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource SidebarActionButton}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tags.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <TextBlock Style="{StaticResource SidebarIcon}" FontFamily="{x:Static SystemFonts.MessageFontFamily}"
                       FontWeight="SemiBold" Text="#" HorizontalAlignment="Center" />
        </Button>
    </Grid>

    <!-- Flyout of the Tags, opened by the "#" button of the rail. Esc or picking a Tag closes it. -->
    <Popup x:Name="TagsFlyout" PlacementTarget="{Binding ElementName=RailTagsButton}" Placement="Right"
           StaysOpen="False" Opened="OnTagsFlyoutOpened">
        <Border Style="{StaticResource SidebarOverlay}" MinWidth="160" MaxHeight="320"
                PreviewKeyDown="OnTagsFlyoutKeyDown">
            <ListBox x:Name="RailTagList" ItemsSource="{Binding Tags}" Style="{StaticResource SidebarListBox}"
                     ItemContainerStyle="{StaticResource TagItemContainer}"
                     AutomationProperties.Name="Tags" AutomationProperties.AutomationId="RailTagList"
                     PreviewKeyDown="OnTagKeyDown" SelectionChanged="OnTagSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Name, StringFormat=#{0}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Popup>

    <!-- The full sidebar as an overlay on top of the rail (SetRail moves FullSidebar in here). -->
    <Popup x:Name="Overlay" PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}"
           Placement="Relative" StaysOpen="False" Opened="OnOverlayOpened" Closed="OnOverlayClosed">
        <Border x:Name="OverlayHost" Style="{StaticResource SidebarOverlay}" Width="260"
                PreviewKeyDown="OnOverlayKeyDown" />
    </Popup>
    </Grid>
</UserControl>
