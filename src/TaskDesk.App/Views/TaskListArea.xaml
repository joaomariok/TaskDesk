<UserControl x:Class="TaskDesk.App.Views.TaskListArea"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TaskDesk.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="TaskRowContainer" TargetType="ListBoxItem">
            <!-- Narrator announces a row by its Task title. -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        </Style>
        <!-- A hint drawn over an empty TextBox; the TextBox text arrives through Tag. -->
        <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,10,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="TaskRowTemplate">
            <DockPanel x:Name="RowRoot" LastChildFill="True">
                <Border DockPanel.Dock="Left" Style="{StaticResource RowListStripe}"
                        Background="{Binding ListColorHex}" />
                <!-- Fluent's box without the room Fluent reserves for a label, so the row stays compact. -->
                <controls:CommandCheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                          MinWidth="0" MinHeight="0"
                          AutomationProperties.Name="Completed"
                          IsChecked="{Binding IsCompleted, Mode=OneWay}"
                          Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" />
                <Border DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                        Style="{StaticResource DueChip}"
                        Visibility="{Binding HasDue, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource DueChipText}" Text="{Binding DueText}"
                               AutomationProperties.Name="Due" />
                </Border>
                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource PriorityFlag}"
                           Text="&#xE7C1;" AutomationProperties.Name="{Binding PriorityLabel}"
                           ToolTip="{Binding PriorityLabel}"
                           Visibility="{Binding HasPriorityFlag, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource RowCaptionText}"
                           AutomationProperties.Name="List" Text="{Binding ListName}"
                           Visibility="{Binding ShowListName, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding VisibleTags}" AutomationProperties.Name="Tags">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TagChip}">
                                    <TextBlock Style="{StaticResource TagChipText}" Text="{Binding Name, StringFormat=#{0}}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource RowCaptionText}" Text="{Binding TagOverflowText}"
                               AutomationProperties.Name="More tags"
                               Visibility="{Binding HasTagOverflow, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource RowCaptionText}"
                           AutomationProperties.Name="Subtask progress"
                           Text="{Binding SubtaskProgress}"
                           Visibility="{Binding HasSubtasks, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource RowIcon}"
                           Text="&#xE8EE;" AutomationProperties.Name="Repeats" ToolTip="Repeats"
                           Visibility="{Binding IsRecurring, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock x:Name="RowTitle" Style="{StaticResource RowTitleText}" Text="{Binding Title}" ToolTip="{Binding Title}" />
            </DockPanel>
            <DataTemplate.Triggers>
                <!-- A completed Task is dimmed; the move into "Completed (N)" follows after a moment. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCompleted}" Value="True" />
                        <Condition Binding="{Binding KeepsFullStrength}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="RowRoot" Property="Opacity" Value="0.6" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <!-- The heading row (heading, Filter button, search), the Filter row, quick add, the Overdue, open and
         Completed Task lists, Tags of the selected Task and the Undo bar. -->
    <DockPanel>
        <!-- Shown when Reminders fall back to tray balloons -->
        <controls:InfoBar DockPanel.Dock="Top" Margin="0,0,0,8" Severity="Warning" IsClosable="True"
                          AutomationProperties.Name="Notifications unavailable"
                          CloseCommand="{Binding DismissNotificationBannerCommand}"
                          Visibility="{Binding HasNotificationBanner, Converter={StaticResource BoolToVisibility}}"
                          Content="{Binding NotificationBanner}" />
        <!-- Undo bar -->
        <controls:InfoBar DockPanel.Dock="Bottom" Margin="0,8,0,0"
                          AutomationProperties.Name="Task deleted"
                          ActionContent="Undo" ActionCommand="{Binding UndoCommand}" ActionAutomationId="UndoButton"
                          Visibility="{Binding IsUndoBarVisible, Converter={StaticResource BoolToVisibility}}"
                          Content="{Binding UndoBarText}" />
        <!-- Heading row: the heading and its List menu on the left (a long heading ends with an ellipsis),
             then the Filter button and the scoped search box on the right. The Filter row sits under it only
             while asked for or while a Filter is on. Element order follows the screen, so Tab does too. -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="160" MaxWidth="280" />
                </Grid.ColumnDefinitions>
                <!-- Left-aligned, so the star column is as wide as the heading until space runs out. -->
                <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SubtitleText}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="PageHeading"
                               Text="{Binding PageHeading}" ToolTip="{Binding PageHeading}" />
                    <Button x:Name="ListMenuButton" Grid.Column="1" Content="&#x22EF;" Margin="4,0,0,0" Padding="8,2"
                            VerticalAlignment="Center" Click="ListMenuButton_Click"
                            AutomationProperties.Name="List settings"
                            AutomationProperties.AutomationId="ListMenuButton"
                            ToolTip="List settings"
                            Visibility="{Binding IsListPage, Converter={StaticResource BoolToVisibility}}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename" Click="ListRename_Click" />
                                <MenuItem Header="Colour">
                                    <MenuItem Header="None" Tag="" Click="ListColour_Click" />
                                    <MenuItem Header="Red" Tag="#D13438" Click="ListColour_Click" />
                                    <MenuItem Header="Orange" Tag="#F7630C" Click="ListColour_Click" />
                                    <MenuItem Header="Yellow" Tag="#FFB900" Click="ListColour_Click" />
                                    <MenuItem Header="Green" Tag="#107C10" Click="ListColour_Click" />
                                    <MenuItem Header="Blue" Tag="#0078D4" Click="ListColour_Click" />
                                    <MenuItem Header="Purple" Tag="#744DA9" Click="ListColour_Click" />
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>
                <controls:CommandToggleButton Grid.Column="1" Margin="8,0,8,0" Padding="8,2"
                              AutomationProperties.Name="Filter"
                              AutomationProperties.AutomationId="FilterButton"
                              ToolTip="Show or hide the Filters"
                              IsChecked="{Binding IsFilterBarShown, Mode=OneWay}"
                              Command="{Binding ToggleFilterBarCommand}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Fluent's implicit TextBlock style would keep the resting text colour; take the
                             colour the template gives the content, so the pressed state reads too. -->
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="16"
                                   VerticalAlignment="Center" Text="&#xE71C;" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Filter" />
                    </StackPanel>
                </controls:CommandToggleButton>
                <Grid Grid.Column="2">
                    <TextBox x:Name="SearchBox" Padding="6"
                             AutomationProperties.Name="Search (Ctrl+F)" AutomationProperties.AutomationId="SearchBox"
                             ToolTip="Search (Ctrl+F). Esc clears."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="SearchBox_TextChanged" />
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding SearchScope}"
                               Tag="{Binding Text, ElementName=SearchBox}" />
                </Grid>
            </Grid>
            <!-- A UserControl, unlike a bare panel, is exposed to UI Automation with its name and Id. -->
            <UserControl Margin="0,8,0,0" IsTabStop="False" Focusable="False"
                         AutomationProperties.Name="Filters" AutomationProperties.AutomationId="FilterBar"
                         Visibility="{Binding IsFilterBarShown, Converter={StaticResource BoolToVisibility}}">
                <WrapPanel>
                    <ComboBox x:Name="PriorityFilterBox" Width="150" Margin="0,0,6,0"
                              AutomationProperties.Name="Priority filter"
                              SelectionChanged="PriorityFilterBox_SelectionChanged" />
                    <controls:CommandToggleButton Content="Has due" Padding="8,2" Margin="0,0,6,0"
                                  AutomationProperties.Name="Has due filter"
                                  IsChecked="{Binding HasDueFilter, Mode=OneWay}"
                                  Command="{Binding ToggleHasDueFilterCommand}" />
                    <controls:CommandToggleButton Content="Has reminder" Padding="8,2" Margin="0,0,6,0"
                                  AutomationProperties.Name="Has reminder filter"
                                  IsChecked="{Binding HasReminderFilter, Mode=OneWay}"
                                  Command="{Binding ToggleHasReminderFilterCommand}" />
                    <ItemsControl ItemsSource="{Binding FilterTagChips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Fluent's ToggleButton ignores ContentStringFormat, so the "#" is in the text. -->
                                <controls:CommandToggleButton Padding="8,2"
                                              Margin="0,0,6,0" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              AutomationProperties.Name="{Binding Tag.Name, StringFormat=#{0}}"
                                              Command="{Binding DataContext.ToggleFilterTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding Tag}">
                                    <TextBlock Text="{Binding Tag.Name, StringFormat=#{0}}" />
                                </controls:CommandToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Clear filters" Padding="8,2" Command="{Binding ClearAllFiltersCommand}"
                            Visibility="{Binding HasFilter, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
            </UserControl>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}"
                   AutomationProperties.AutomationId="QuickAddLabel"
                   Visibility="{Binding ShowsQuickAdd, Converter={StaticResource BoolToVisibility}}"
                   Text="{Binding QuickAddTarget}" />
        <TextBox x:Name="QuickAddBox" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="6"
                 AutomationProperties.Name="Quick add" AutomationProperties.AutomationId="QuickAddBox"
                 Visibility="{Binding ShowsQuickAdd, Converter={StaticResource BoolToVisibility}}"
                 Text="{Binding QuickAddTitle, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.InputBindings>
                <KeyBinding Key="Return" Command="{Binding AddTaskCommand}" />
            </TextBox.InputBindings>
        </TextBox>
        <!-- Empty and no-result states: plain text, no box or outline. -->
        <StackPanel DockPanel.Dock="Top" Margin="0,8,0,8" AutomationProperties.AutomationId="EmptyState"
                    Visibility="{Binding HasEmptyMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       AutomationProperties.AutomationId="EmptyMessage"
                       Text="{Binding EmptyMessage}" />
            <Button Content="Clear search" Margin="0,8,0,0" Padding="8,2" HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="ClearSearchButton"
                    Command="{Binding ClearSearchCommand}"
                    Visibility="{Binding ShowClearSearch, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Content="Load more completed tasks" Margin="0,8,0,0" Padding="8,2"
                HorizontalAlignment="Left" Command="{Binding LoadMoreCompletedCommand}"
                Visibility="{Binding HasMoreCompleted, Converter={StaticResource BoolToVisibility}}" />
        <Expander DockPanel.Dock="Bottom" Margin="0,8,0,0"
                  Visibility="{Binding HasCompletedTasks, Converter={StaticResource BoolToVisibility}}"
                  Header="{Binding CompletedHeader}"
                  IsExpanded="{Binding IsCompletedExpanded, Mode=TwoWay}">
            <ListBox x:Name="CompletedList" MaxHeight="160" BorderThickness="0" Background="Transparent" ItemsSource="{Binding CompletedTasks}"
                     HorizontalContentAlignment="Stretch" AutomationProperties.Name="Completed tasks" AutomationProperties.AutomationId="CompletedTaskList"
                     ItemContainerStyle="{StaticResource TaskRowContainer}"
                     ItemTemplate="{StaticResource TaskRowTemplate}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     SelectionChanged="TaskList_SelectionChanged"
                     KeyDown="TaskList_KeyDown" MouseLeftButtonUp="TaskList_MouseLeftButtonUp">
                <ListBox.InputBindings>
                    <KeyBinding Key="Space" Command="{Binding ToggleSelectedCompleteCommand}" />
                    <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
                </ListBox.InputBindings>
            </ListBox>
        </Expander>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8"
                    Visibility="{Binding HasOverdueTasks, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding OverdueHeader}" Style="{StaticResource BodyStrongText}"
                       Foreground="{DynamicResource OverdueBrush}" Margin="0,0,0,4" />
            <ListBox x:Name="OverdueList" MaxHeight="160" BorderThickness="0" Background="Transparent" ItemsSource="{Binding OverdueTasks}"
                     HorizontalContentAlignment="Stretch" AutomationProperties.Name="Overdue tasks"
                     ItemContainerStyle="{StaticResource TaskRowContainer}"
                     ItemTemplate="{StaticResource TaskRowTemplate}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     SelectionChanged="TaskList_SelectionChanged"
                     KeyDown="TaskList_KeyDown" MouseLeftButtonUp="TaskList_MouseLeftButtonUp">
                <ListBox.InputBindings>
                    <KeyBinding Key="Space" Command="{Binding ToggleSelectedCompleteCommand}" />
                    <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
                </ListBox.InputBindings>
            </ListBox>
        </StackPanel>
        <!-- With no rows (the Completed view, an empty List) the list takes no focus, so Tab skips it and
             no empty focus rectangle shows; with rows, the keyboard reaches it as usual. -->
        <ListBox x:Name="OpenList" ItemsSource="{Binding Tasks}" AllowDrop="True"
                 Style="{StaticResource FocusableWhenNotEmptyListBox}"
                 BorderThickness="0" Background="Transparent"
                 HorizontalContentAlignment="Stretch" AutomationProperties.Name="Tasks" AutomationProperties.AutomationId="OpenTaskList"
                 ItemContainerStyle="{StaticResource TaskRowContainer}"
                 ItemTemplate="{StaticResource TaskRowTemplate}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True"
                 SelectionChanged="TaskList_SelectionChanged"
                 KeyDown="TaskList_KeyDown" MouseLeftButtonUp="TaskList_MouseLeftButtonUp"
                 PreviewMouseLeftButtonDown="TaskList_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="TaskList_PreviewMouseMove"
                 DragOver="TaskList_DragOver" Drop="TaskList_Drop">
            <ListBox.InputBindings>
                <KeyBinding Key="Space" Command="{Binding ToggleSelectedCompleteCommand}" />
                <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
            </ListBox.InputBindings>
        </ListBox>
    </DockPanel>
</UserControl>
