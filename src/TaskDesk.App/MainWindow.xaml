<Window x:Class="TaskDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tasks="clr-namespace:TaskDesk.Core.Tasks;assembly=TaskDesk.Core"
        xmlns:views="clr-namespace:TaskDesk.App.Views"
        Title="TaskDesk" Height="600" Width="900" MinWidth="800" MinHeight="500"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SelectSmartViewCommand}"
                    CommandParameter="{x:Static tasks:SmartView.Today}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SelectSmartViewCommand}"
                    CommandParameter="{x:Static tasks:SmartView.Upcoming}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SelectSmartViewCommand}"
                    CommandParameter="{x:Static tasks:SmartView.Overdue}" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding SelectSmartViewCommand}"
                    CommandParameter="{x:Static tasks:SmartView.All}" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding SelectSmartViewCommand}"
                    CommandParameter="{x:Static tasks:SmartView.Completed}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="12">
        <!-- Sidebar | splitter | Task list | splitter | detail pane. Each pane is a UserControl in Views/.
             Pane widths and limits come from PaneLayout and are saved in settings.json
             (MainWindow.xaml.cs, WindowLayoutService). -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="180" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="240" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="DetailColumn" Width="260" />
        </Grid.ColumnDefinitions>
        <views:NavigationPane x:Name="Navigation" Grid.Column="0" AutomationProperties.AutomationId="NavigationPane" />
        <GridSplitter Grid.Column="1" AutomationProperties.AutomationId="SidebarSplitter" Width="12" HorizontalAlignment="Stretch" Background="Transparent"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Focusable="False"
                      AutomationProperties.Name="Resize sidebar" />
        <GridSplitter x:Name="DetailSplitter" AutomationProperties.AutomationId="DetailSplitter" Grid.Column="3" Width="12" HorizontalAlignment="Stretch"
                      Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      Focusable="False" AutomationProperties.Name="Resize detail pane"
                      Visibility="{Binding IsDetailPaneVisible, Converter={StaticResource BoolToVisibility}}" />
        <!-- Detail pane -->
        <views:DetailPane x:Name="Details" Grid.Column="4" AutomationProperties.AutomationId="DetailPane" />
        <views:TaskListArea x:Name="TaskArea" Grid.Column="2" />
    </Grid>
</Window>
