<Window x:Class="TaskDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskDesk" Height="480" Width="760"
        FocusManager.FocusedElement="{Binding ElementName=QuickAddBox}">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Left" Width="160" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="TAGS" FontWeight="Bold" Margin="0,0,0,4" />
            <Button x:Name="ShowAllButton" DockPanel.Dock="Top" Content="All tasks" Margin="0,0,0,4"
                    AutomationProperties.Name="Show all tasks" Click="OnShowAllClick" />
            <Button x:Name="DeleteTagButton" DockPanel.Dock="Bottom" Content="Delete tag" Margin="0,4,0,0"
                    AutomationProperties.Name="Delete selected tag" Click="OnDeleteTagClick" />
            <ListBox x:Name="TagList" ItemsSource="{Binding Tags}" AutomationProperties.Name="Tags"
                     SelectionChanged="OnTagSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name, StringFormat=#{0}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding SelectedTask.Tags}" AutomationProperties.Name="Task tags">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,4,4" Padding="6,1"
                                Command="{Binding DataContext.RemoveTagCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="Remove tag">
                            <TextBlock>
                                <Run Text="#" /><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" x" />
                            </TextBlock>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Add tag" Margin="4,0,0,0" Padding="8,2"
                        Command="{Binding AddTagCommand}" />
                <TextBox Padding="4" AutomationProperties.Name="New tag name"
                         Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddTagCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </StackPanel>
        <TextBox x:Name="QuickAddBox" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="6"
                 AutomationProperties.Name="Quick add"
                 Text="{Binding QuickAddTitle, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.InputBindings>
                <KeyBinding Key="Return" Command="{Binding AddTaskCommand}" />
            </TextBox.InputBindings>
        </TextBox>
        <ListBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" AllowDrop="True"
                 HorizontalContentAlignment="Stretch" AutomationProperties.Name="Tasks"
                 PreviewMouseLeftButtonDown="TaskList_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="TaskList_PreviewMouseMove"
                 DragOver="TaskList_DragOver" Drop="TaskList_Drop">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name, StringFormat=#{0}}" Margin="6,0,0,0"
                                               Foreground="SteelBlue" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
