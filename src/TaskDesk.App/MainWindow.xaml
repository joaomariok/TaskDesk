<Window x:Class="TaskDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskDesk" Height="600" Width="900" MinWidth="800" MinHeight="500"
        FocusManager.FocusedElement="{Binding ElementName=QuickAddBox}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <DataTemplate x:Key="TaskRowTemplate">
            <DockPanel LastChildFill="True">
                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                          AutomationProperties.Name="Completed"
                          IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                          Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" />
                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" FontWeight="Bold" Foreground="OrangeRed"
                           Text="{Binding PriorityMarker}" />
                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Foreground="Gray"
                           AutomationProperties.Name="Subtask progress"
                           Text="{Binding SubtaskProgress}"
                           Visibility="{Binding HasSubtasks, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Tags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name, StringFormat=#{0}}" Margin="6,0,0,0"
                                       Foreground="SteelBlue" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Left" Width="180" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,8"
                       DataContext="{Binding Lists, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock DockPanel.Dock="Top" Text="LISTS" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBox DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="4"
                         AutomationProperties.Name="New list"
                         Text="{Binding NewListName, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding CreateListCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock DockPanel.Dock="Bottom" Foreground="Firebrick" TextWrapping="Wrap"
                           Text="{Binding ErrorMessage}" />
                <ListBox ItemsSource="{Binding Lists}" AllowDrop="True" AutomationProperties.Name="Lists"
                         PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove"
                         Drop="OnListDrop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" Background="Transparent">
                                <DockPanel.ContextMenu>
                                    <ContextMenu Opened="OnMenuOpened">
                                        <MenuItem Header="Rename" Click="OnRenameClick" />
                                        <MenuItem Header="Color">
                                            <MenuItem Header="None" Tag="" Click="OnColorClick" />
                                            <MenuItem Header="Red" Tag="#D13438" Click="OnColorClick" />
                                            <MenuItem Header="Orange" Tag="#F7630C" Click="OnColorClick" />
                                            <MenuItem Header="Yellow" Tag="#FFB900" Click="OnColorClick" />
                                            <MenuItem Header="Green" Tag="#107C10" Click="OnColorClick" />
                                            <MenuItem Header="Blue" Tag="#0078D4" Click="OnColorClick" />
                                            <MenuItem Header="Purple" Tag="#744DA9" Click="OnColorClick" />
                                        </MenuItem>
                                        <MenuItem Header="Delete" Tag="delete" Click="OnDeleteClick" />
                                    </ContextMenu>
                                </DockPanel.ContextMenu>
                                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Opacity="0.7"
                                           Text="{Binding OpenTaskCount}" />
                                <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,6,0"
                                         Fill="{Binding ColorHex, TargetNullValue=Transparent, FallbackValue=Transparent}" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <DockPanel Grid.Row="1">
                <TextBlock DockPanel.Dock="Top" Text="TAGS" FontWeight="Bold" Margin="0,0,0,4" />
                <Button x:Name="ShowAllButton" DockPanel.Dock="Top" Content="All tasks" Margin="0,0,0,4"
                        AutomationProperties.Name="Show all tasks" Click="OnShowAllClick" />
                <Button x:Name="DeleteTagButton" DockPanel.Dock="Bottom" Content="Delete tag" Margin="0,4,0,0"
                        AutomationProperties.Name="Delete selected tag" Click="OnDeleteTagClick" />
                <ListBox x:Name="TagList" ItemsSource="{Binding Tags}" AutomationProperties.Name="Tags"
                         SelectionChanged="OnTagSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name, StringFormat=#{0}}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
        <!-- Detail pane -->
        <ScrollViewer DockPanel.Dock="Right" Width="260" Margin="12,0,0,0"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsDetailPaneVisible, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Margin="0,0,8,0">
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseDetailPaneCommand}"
                        AutomationProperties.Name="Close detail pane" />
                <TextBlock Text="Details" FontWeight="Bold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="Title" />
            <TextBox x:Name="DetailTitleBox" Padding="4" Margin="0,2,0,8" MaxLength="500"
                     AutomationProperties.Name="Task title"
                     Text="{Binding DetailTitle, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Priority" />
            <ComboBox x:Name="PriorityBox" Margin="0,2,0,8" AutomationProperties.Name="Priority"
                      SelectedItem="{Binding DetailPriority}" />
            <TextBlock Text="Notes" />
            <TextBox Height="160" Margin="0,2,0,8" Padding="4" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" MaxLength="10000"
                     AutomationProperties.Name="Task notes"
                     Text="{Binding DetailNotes, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Subtasks" />
            <ItemsControl ItemsSource="{Binding SubtaskItems}" Margin="0,2,0,4"
                          AutomationProperties.Name="Subtasks">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,1">
                            <Button DockPanel.Dock="Right" Content="x" Padding="5,0" Margin="2,0,0,0"
                                    AutomationProperties.Name="Delete subtask" ToolTip="Delete subtask"
                                    Command="{Binding DataContext.DeleteSubtaskCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <Button DockPanel.Dock="Right" Content="&#x25BC;" Padding="4,0" Margin="2,0,0,0"
                                    AutomationProperties.Name="Move subtask down" ToolTip="Move down"
                                    Command="{Binding DataContext.MoveSubtaskDownCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <Button DockPanel.Dock="Right" Content="&#x25B2;" Padding="4,0" Margin="2,0,0,0"
                                    AutomationProperties.Name="Move subtask up" ToolTip="Move up"
                                    Command="{Binding DataContext.MoveSubtaskUpCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0"
                                      AutomationProperties.Name="Subtask done"
                                      IsChecked="{Binding IsCompleted}" />
                            <TextBox MaxLength="500" Padding="2" AutomationProperties.Name="Subtask title"
                                     Text="{Binding Title, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Add" Margin="4,0,0,0" Padding="8,2"
                        Command="{Binding AddSubtaskCommand}" />
                <TextBox Padding="4" MaxLength="500" AutomationProperties.Name="New subtask title"
                         Text="{Binding NewSubtaskTitle, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddSubtaskCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
            <Button Content="Delete" HorizontalAlignment="Left" Padding="12,4"
                    Command="{Binding DeleteSelectedCommand}" />
            <TextBlock Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding ErrorMessage}" />
        </StackPanel>
        </ScrollViewer>
        <!-- Undo bar -->
        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10,6" Background="#333"
                Visibility="{Binding IsUndoBarVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Undo" Command="{Binding UndoCommand}" Padding="10,2" />
                <TextBlock Foreground="White" VerticalAlignment="Center" Text="{Binding UndoBarText, StringFormat={}{0} &#x2014;}" />
            </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding SelectedTask.Tags}" AutomationProperties.Name="Task tags">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,4,4" Padding="6,1"
                                Command="{Binding DataContext.RemoveTagCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="Remove tag">
                            <TextBlock>
                                <Run Text="#" /><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" x" />
                            </TextBlock>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Add tag" Margin="4,0,0,0" Padding="8,2"
                        Command="{Binding AddTagCommand}" />
                <TextBox Padding="4" AutomationProperties.Name="New tag name"
                         Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddTagCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </StackPanel>
        <TextBox x:Name="QuickAddBox" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="6"
                 AutomationProperties.Name="Quick add"
                 Text="{Binding QuickAddTitle, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.InputBindings>
                <KeyBinding Key="Return" Command="{Binding AddTaskCommand}" />
            </TextBox.InputBindings>
        </TextBox>
        <Expander DockPanel.Dock="Bottom" Margin="0,8,0,0"
                  Visibility="{Binding HasCompletedTasks, Converter={StaticResource BoolToVisibility}}"
                  Header="{Binding CompletedHeader}"
                  IsExpanded="{Binding IsCompletedExpanded, Mode=TwoWay}">
            <ListBox x:Name="CompletedList" MaxHeight="160" ItemsSource="{Binding CompletedTasks}"
                     HorizontalContentAlignment="Stretch" AutomationProperties.Name="Completed tasks"
                     ItemTemplate="{StaticResource TaskRowTemplate}"
                     SelectionChanged="TaskList_SelectionChanged">
                <ListBox.InputBindings>
                    <KeyBinding Key="Space" Command="{Binding ToggleSelectedCompleteCommand}" />
                    <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
                </ListBox.InputBindings>
            </ListBox>
        </Expander>
        <ListBox x:Name="OpenList" ItemsSource="{Binding Tasks}" AllowDrop="True"
                 HorizontalContentAlignment="Stretch" AutomationProperties.Name="Tasks"
                 ItemTemplate="{StaticResource TaskRowTemplate}"
                 SelectionChanged="TaskList_SelectionChanged"
                 PreviewMouseLeftButtonDown="TaskList_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="TaskList_PreviewMouseMove"
                 DragOver="TaskList_DragOver" Drop="TaskList_Drop">
            <ListBox.InputBindings>
                <KeyBinding Key="Space" Command="{Binding ToggleSelectedCompleteCommand}" />
                <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
            </ListBox.InputBindings>
        </ListBox>
    </DockPanel>
</Window>
