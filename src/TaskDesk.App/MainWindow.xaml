<Window x:Class="TaskDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tasks="clr-namespace:TaskDesk.Core.Tasks;assembly=TaskDesk.Core"
        xmlns:presentation="clr-namespace:TaskDesk.Presentation;assembly=TaskDesk.Presentation"
        Title="TaskDesk" Height="600" Width="900" MinWidth="800" MinHeight="500"
        FocusManager.FocusedElement="{Binding ElementName=QuickAddBox}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SelectSmartViewCommand}"
                    CommandParameter="{x:Static tasks:SmartView.Today}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SelectSmartViewCommand}"
                    CommandParameter="{x:Static tasks:SmartView.Upcoming}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SelectSmartViewCommand}"
                    CommandParameter="{x:Static tasks:SmartView.Overdue}" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding SelectSmartViewCommand}"
                    CommandParameter="{x:Static tasks:SmartView.All}" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding SelectSmartViewCommand}"
                    CommandParameter="{x:Static tasks:SmartView.Completed}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <DataTemplate x:Key="TaskRowTemplate">
            <DockPanel LastChildFill="True">
                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                          AutomationProperties.Name="Completed"
                          IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                          Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" />
                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" FontWeight="Bold" Foreground="OrangeRed"
                           Text="{Binding PriorityMarker}" />
                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="&#x21BB;" Foreground="Gray"
                           AutomationProperties.Name="Repeats" ToolTip="Repeats"
                           Visibility="{Binding IsRecurring, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding DueText}"
                           AutomationProperties.Name="Due">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Opacity" Value="0.7" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                    <Setter Property="Foreground" Value="Red" />
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Foreground="Gray"
                           AutomationProperties.Name="Subtask progress"
                           Text="{Binding SubtaskProgress}"
                           Visibility="{Binding HasSubtasks, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Tags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name, StringFormat=#{0}}" Margin="6,0,0,0"
                                       Foreground="SteelBlue" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="12">
        <!-- Sidebar | splitter | Task list | splitter | detail pane. Pane widths and limits come from
             PaneLayout and are saved in settings.json (MainWindow.xaml.cs, WindowLayoutService). -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="180" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="240" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="DetailColumn" Width="260" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="SMART VIEWS" FontWeight="Bold" Margin="0,0,0,4" />
                <Button Content="Today (Ctrl+1)" HorizontalContentAlignment="Left" Padding="6,2" Margin="0,0,0,2"
                        Command="{Binding SelectSmartViewCommand}" CommandParameter="{x:Static tasks:SmartView.Today}" />
                <Button Content="Upcoming (Ctrl+2)" HorizontalContentAlignment="Left" Padding="6,2" Margin="0,0,0,2"
                        Command="{Binding SelectSmartViewCommand}" CommandParameter="{x:Static tasks:SmartView.Upcoming}" />
                <Button Content="Overdue (Ctrl+3)" HorizontalContentAlignment="Left" Padding="6,2" Margin="0,0,0,2"
                        Command="{Binding SelectSmartViewCommand}" CommandParameter="{x:Static tasks:SmartView.Overdue}" />
                <Button Content="All (Ctrl+4)" HorizontalContentAlignment="Left" Padding="6,2" Margin="0,0,0,2"
                        Command="{Binding SelectSmartViewCommand}" CommandParameter="{x:Static tasks:SmartView.All}" />
                <Button Content="Completed (Ctrl+5)" HorizontalContentAlignment="Left" Padding="6,2" Margin="0,0,0,2"
                        Command="{Binding SelectSmartViewCommand}" CommandParameter="{x:Static tasks:SmartView.Completed}" />
            </StackPanel>
            <DockPanel Grid.Row="1" Margin="0,0,0,8"
                       DataContext="{Binding Lists, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock DockPanel.Dock="Top" Text="LISTS" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBox DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="4"
                         AutomationProperties.Name="New list"
                         Text="{Binding NewListName, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding CreateListCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock DockPanel.Dock="Bottom" Foreground="Firebrick" TextWrapping="Wrap"
                           Text="{Binding ErrorMessage}" />
                <ListBox ItemsSource="{Binding Lists}" AllowDrop="True" AutomationProperties.Name="Lists"
                         PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove"
                         Drop="OnListDrop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" Background="Transparent">
                                <DockPanel.ContextMenu>
                                    <ContextMenu Opened="OnMenuOpened">
                                        <MenuItem Header="Rename" Click="OnRenameClick" />
                                        <MenuItem Header="Color">
                                            <MenuItem Header="None" Tag="" Click="OnColorClick" />
                                            <MenuItem Header="Red" Tag="#D13438" Click="OnColorClick" />
                                            <MenuItem Header="Orange" Tag="#F7630C" Click="OnColorClick" />
                                            <MenuItem Header="Yellow" Tag="#FFB900" Click="OnColorClick" />
                                            <MenuItem Header="Green" Tag="#107C10" Click="OnColorClick" />
                                            <MenuItem Header="Blue" Tag="#0078D4" Click="OnColorClick" />
                                            <MenuItem Header="Purple" Tag="#744DA9" Click="OnColorClick" />
                                        </MenuItem>
                                        <MenuItem Header="Delete" Tag="delete" Click="OnDeleteClick" />
                                    </ContextMenu>
                                </DockPanel.ContextMenu>
                                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Opacity="0.7"
                                           Text="{Binding OpenTaskCount}" />
                                <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,6,0"
                                         Fill="{Binding ColorHex, TargetNullValue=Transparent, FallbackValue=Transparent}" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" Text="TAGS" FontWeight="Bold" Margin="0,0,0,4" />
                <Button x:Name="ShowAllButton" DockPanel.Dock="Top" Content="All tasks" Margin="0,0,0,4"
                        AutomationProperties.Name="Show all tasks" Click="OnShowAllClick" />
                <Button x:Name="DeleteTagButton" DockPanel.Dock="Bottom" Content="Delete tag" Margin="0,4,0,0"
                        AutomationProperties.Name="Delete selected tag" Click="OnDeleteTagClick" />
                <ListBox x:Name="TagList" ItemsSource="{Binding Tags}" AutomationProperties.Name="Tags"
                         SelectionChanged="OnTagSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name, StringFormat=#{0}}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
        <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Focusable="False"
                      AutomationProperties.Name="Resize sidebar" />
        <GridSplitter x:Name="DetailSplitter" Grid.Column="3" Width="12" HorizontalAlignment="Stretch"
                      Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      Focusable="False" AutomationProperties.Name="Resize detail pane"
                      Visibility="{Binding IsDetailPaneVisible, Converter={StaticResource BoolToVisibility}}" />
        <!-- Detail pane -->
        <ScrollViewer Grid.Column="4"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsDetailPaneVisible, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Margin="0,0,8,0">
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseDetailPaneCommand}"
                        AutomationProperties.Name="Close detail pane" />
                <TextBlock Text="Details" FontWeight="Bold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="Title" />
            <TextBox x:Name="DetailTitleBox" Padding="4" Margin="0,2,0,8" MaxLength="500"
                     AutomationProperties.Name="Task title"
                     Text="{Binding DetailTitle, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Priority" />
            <ComboBox x:Name="PriorityBox" Margin="0,2,0,8" AutomationProperties.Name="Priority"
                      SelectedItem="{Binding DetailPriority}" />
            <TextBlock Text="Due" />
            <DockPanel Margin="0,2,0,8">
                <TextBox DockPanel.Dock="Right" Width="60" Padding="4" Margin="6,0,0,0" MaxLength="5"
                         AutomationProperties.Name="Due time"
                         ToolTip="Due time as HH:mm (needs a Due date)"
                         Text="{Binding DetailDueTime, UpdateSourceTrigger=LostFocus}" />
                <DatePicker SelectedDate="{Binding DetailDueDate}" AutomationProperties.Name="Due date" />
            </DockPanel>
            <TextBlock Text="Reminder" />
            <DockPanel Margin="0,2,0,8">
                <TextBox DockPanel.Dock="Right" Width="60" Padding="4" Margin="6,0,0,0" MaxLength="5"
                         AutomationProperties.Name="Reminder time"
                         ToolTip="Reminder time as HH:mm (empty means 09:00)"
                         Text="{Binding DetailReminderTime, UpdateSourceTrigger=LostFocus}" />
                <DatePicker SelectedDate="{Binding DetailReminderDate}" AutomationProperties.Name="Reminder date" />
            </DockPanel>
            <DockPanel Margin="0,-4,0,8"
                       Visibility="{Binding HasDetailSnooze, Converter={StaticResource BoolToVisibility}}">
                <Button DockPanel.Dock="Right" Content="Clear Snooze" Padding="6,2"
                        Command="{Binding ClearSnoozeCommand}"
                        ToolTip="Clear the Snooze; the planned Reminder fires again" />
                <TextBlock Text="{Binding DetailSnooze}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="Repeat" />
            <StackPanel Margin="0,2,0,8" DataContext="{Binding Repeat}">
                <ComboBox AutomationProperties.Name="Repeat"
                          ItemsSource="{x:Static presentation:RepeatEditorViewModel.Presets}"
                          SelectedItem="{Binding Preset}" />
                <DockPanel Margin="0,4,0,0"
                           Visibility="{Binding HasInterval, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="50" Padding="2" MaxLength="3" AutomationProperties.Name="Repeat every"
                             ToolTip="Every N days, weeks, months or years"
                             Text="{Binding Interval, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text="{Binding Preset}" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.7" />
                </DockPanel>
                <WrapPanel Margin="0,4,0,0" Visibility="{Binding HasDays, Converter={StaticResource BoolToVisibility}}">
                    <CheckBox Content="Mon" Margin="0,0,6,0" IsChecked="{Binding Monday}" AutomationProperties.Name="Monday" />
                    <CheckBox Content="Tue" Margin="0,0,6,0" IsChecked="{Binding Tuesday}" AutomationProperties.Name="Tuesday" />
                    <CheckBox Content="Wed" Margin="0,0,6,0" IsChecked="{Binding Wednesday}" AutomationProperties.Name="Wednesday" />
                    <CheckBox Content="Thu" Margin="0,0,6,0" IsChecked="{Binding Thursday}" AutomationProperties.Name="Thursday" />
                    <CheckBox Content="Fri" Margin="0,0,6,0" IsChecked="{Binding Friday}" AutomationProperties.Name="Friday" />
                    <CheckBox Content="Sat" Margin="0,0,6,0" IsChecked="{Binding Saturday}" AutomationProperties.Name="Saturday" />
                    <CheckBox Content="Sun" Margin="0,0,6,0" IsChecked="{Binding Sunday}" AutomationProperties.Name="Sunday" />
                </WrapPanel>
                <DockPanel Margin="0,4,0,0"
                           Visibility="{Binding HasDayOfMonth, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="On day" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="50" Padding="2" MaxLength="2" AutomationProperties.Name="Day of month"
                             ToolTip="Day of the month (1-31; shorter months use their last day)"
                             Text="{Binding DayOfMonth, UpdateSourceTrigger=LostFocus}" />
                </DockPanel>
                <StackPanel Visibility="{Binding IsRepeating, Converter={StaticResource BoolToVisibility}}">
                    <CheckBox Margin="0,4,0,0" Content="Count from the completion date"
                              AutomationProperties.Name="Repeat from the completion date"
                              IsChecked="{Binding RepeatFromCompletion}" />
                    <TextBlock Text="Ends on (optional)" Margin="0,4,0,0" />
                    <DatePicker SelectedDate="{Binding EndDate}" AutomationProperties.Name="Repeat end date" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Notes" />
            <TextBox Height="160" Margin="0,2,0,8" Padding="4" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" MaxLength="10000"
                     AutomationProperties.Name="Task notes"
                     Text="{Binding DetailNotes, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Subtasks" />
            <ItemsControl ItemsSource="{Binding SubtaskItems}" Margin="0,2,0,4"
                          AutomationProperties.Name="Subtasks">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,1">
                            <Button DockPanel.Dock="Right" Content="x" Padding="5,0" Margin="2,0,0,0"
                                    AutomationProperties.Name="Delete subtask" ToolTip="Delete subtask"
                                    Command="{Binding DataContext.DeleteSubtaskCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <Button DockPanel.Dock="Right" Content="&#x25BC;" Padding="4,0" Margin="2,0,0,0"
                                    AutomationProperties.Name="Move subtask down" ToolTip="Move down"
                                    Command="{Binding DataContext.MoveSubtaskDownCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <Button DockPanel.Dock="Right" Content="&#x25B2;" Padding="4,0" Margin="2,0,0,0"
                                    AutomationProperties.Name="Move subtask up" ToolTip="Move up"
                                    Command="{Binding DataContext.MoveSubtaskUpCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0"
                                      AutomationProperties.Name="Subtask done"
                                      IsChecked="{Binding IsCompleted}" />
                            <TextBox MaxLength="500" Padding="2" AutomationProperties.Name="Subtask title"
                                     Text="{Binding Title, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Add" Margin="4,0,0,0" Padding="8,2"
                        Command="{Binding AddSubtaskCommand}" />
                <TextBox Padding="4" MaxLength="500" AutomationProperties.Name="New subtask title"
                         Text="{Binding NewSubtaskTitle, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddSubtaskCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
            <Button Content="Delete" HorizontalAlignment="Left" Padding="12,4"
                    Command="{Binding DeleteSelectedCommand}" />
            <TextBlock Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding ErrorMessage}" />
        </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Column="2">
        <!-- Shown when Reminders fall back to tray balloons -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,6" BorderThickness="1" BorderBrush="Goldenrod"
                AutomationProperties.Name="Notifications unavailable"
                Visibility="{Binding HasNotificationBanner, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Dismiss" Padding="10,2" Margin="8,0,0,0"
                        Command="{Binding DismissNotificationBannerCommand}" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding NotificationBanner}" />
            </DockPanel>
        </Border>
        <!-- Undo bar -->
        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10,6" Background="#333"
                Visibility="{Binding IsUndoBarVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Undo" Command="{Binding UndoCommand}" Padding="10,2" />
                <TextBlock Foreground="White" VerticalAlignment="Center" Text="{Binding UndoBarText, StringFormat={}{0} &#x2014;}" />
            </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding SelectedTask.Tags}" AutomationProperties.Name="Task tags">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,4,4" Padding="6,1"
                                Command="{Binding DataContext.RemoveTagCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="Remove tag">
                            <TextBlock>
                                <Run Text="#" /><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" x" />
                            </TextBlock>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Add tag" Margin="4,0,0,0" Padding="8,2"
                        Command="{Binding AddTagCommand}" />
                <TextBox Padding="4" AutomationProperties.Name="New tag name"
                         Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddTagCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBox x:Name="SearchBox" Padding="6" Margin="0,0,0,4"
                     AutomationProperties.Name="Search (Ctrl+F)"
                     ToolTip="Search (Ctrl+F). Esc clears."
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     TextChanged="SearchBox_TextChanged" />
            <WrapPanel>
                <ComboBox x:Name="PriorityFilterBox" Width="150" Margin="0,0,6,0"
                          AutomationProperties.Name="Priority filter"
                          SelectionChanged="PriorityFilterBox_SelectionChanged" />
                <ToggleButton Content="Has due" Padding="8,2" Margin="0,0,6,0"
                              AutomationProperties.Name="Has due filter"
                              IsChecked="{Binding HasDueFilter, Mode=OneWay}"
                              Command="{Binding ToggleHasDueFilterCommand}" />
                <ToggleButton Content="Has reminder" Padding="8,2" Margin="0,0,6,0"
                              AutomationProperties.Name="Has reminder filter"
                              IsChecked="{Binding HasReminderFilter, Mode=OneWay}"
                              Command="{Binding ToggleHasReminderFilterCommand}" />
                <ItemsControl ItemsSource="{Binding FilterTagChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Content="{Binding Tag.Name}" ContentStringFormat="#{0}" Padding="8,2"
                                          Margin="0,0,6,0" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Command="{Binding DataContext.ToggleFilterTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding Tag}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Clear filters" Padding="8,2" Command="{Binding ClearAllFiltersCommand}"
                        Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
        </StackPanel>
        <TextBox x:Name="QuickAddBox" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="6"
                 AutomationProperties.Name="Quick add"
                 Text="{Binding QuickAddTitle, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.InputBindings>
                <KeyBinding Key="Return" Command="{Binding AddTaskCommand}" />
            </TextBox.InputBindings>
        </TextBox>
        <Button DockPanel.Dock="Bottom" Content="Load more completed tasks" Margin="0,8,0,0" Padding="8,2"
                HorizontalAlignment="Left" Command="{Binding LoadMoreCompletedCommand}"
                Visibility="{Binding HasMoreCompleted, Converter={StaticResource BoolToVisibility}}" />
        <Expander DockPanel.Dock="Bottom" Margin="0,8,0,0"
                  Visibility="{Binding HasCompletedTasks, Converter={StaticResource BoolToVisibility}}"
                  Header="{Binding CompletedHeader}"
                  IsExpanded="{Binding IsCompletedExpanded, Mode=TwoWay}">
            <ListBox x:Name="CompletedList" MaxHeight="160" ItemsSource="{Binding CompletedTasks}"
                     HorizontalContentAlignment="Stretch" AutomationProperties.Name="Completed tasks"
                     ItemTemplate="{StaticResource TaskRowTemplate}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     SelectionChanged="TaskList_SelectionChanged">
                <ListBox.InputBindings>
                    <KeyBinding Key="Space" Command="{Binding ToggleSelectedCompleteCommand}" />
                    <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
                </ListBox.InputBindings>
            </ListBox>
        </Expander>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8"
                    Visibility="{Binding HasOverdueTasks, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding OverdueHeader}" FontWeight="Bold" Foreground="Red" Margin="0,0,0,4" />
            <ListBox x:Name="OverdueList" MaxHeight="160" ItemsSource="{Binding OverdueTasks}"
                     HorizontalContentAlignment="Stretch" AutomationProperties.Name="Overdue tasks"
                     ItemTemplate="{StaticResource TaskRowTemplate}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     SelectionChanged="TaskList_SelectionChanged">
                <ListBox.InputBindings>
                    <KeyBinding Key="Space" Command="{Binding ToggleSelectedCompleteCommand}" />
                    <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
                </ListBox.InputBindings>
            </ListBox>
        </StackPanel>
        <ListBox x:Name="OpenList" ItemsSource="{Binding Tasks}" AllowDrop="True"
                 HorizontalContentAlignment="Stretch" AutomationProperties.Name="Tasks"
                 ItemTemplate="{StaticResource TaskRowTemplate}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True"
                 SelectionChanged="TaskList_SelectionChanged"
                 PreviewMouseLeftButtonDown="TaskList_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="TaskList_PreviewMouseMove"
                 DragOver="TaskList_DragOver" Drop="TaskList_Drop">
            <ListBox.InputBindings>
                <KeyBinding Key="Space" Command="{Binding ToggleSelectedCompleteCommand}" />
                <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
            </ListBox.InputBindings>
        </ListBox>
        </DockPanel>
    </Grid>
</Window>
