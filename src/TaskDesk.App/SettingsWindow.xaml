<Window x:Class="TaskDesk.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TaskDesk.App"
        xmlns:controls="clr-namespace:TaskDesk.App.Controls"
        Title="TaskDesk Settings" Width="640" Height="720" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- A status line under a card; collapsed while it has no text. -->
        <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryCaptionText}">
            <Setter Property="Margin" Value="1,4,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,16,24,24">
            <TextBlock Text="Settings" Style="{StaticResource TitleText}" />

            <!-- Appearance -->
            <TextBlock Text="Appearance" Style="{StaticResource SettingsGroupHeading}" />
            <controls:SettingsCard Header="Theme" Description="Use the Windows setting, or always Light or Dark.">
                <ComboBox MinWidth="160" ItemsSource="{x:Static local:SettingsOptions.Themes}"
                          SelectedItem="{Binding Theme}" AutomationProperties.Name="Theme" />
            </controls:SettingsCard>

            <!-- Startup and tray -->
            <TextBlock Text="Startup and tray" Style="{StaticResource SettingsGroupHeading}" />
            <controls:SettingsCard Header="Start with Windows" Description="Open TaskDesk in the tray when you sign in.">
                <CheckBox IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="Start with Windows" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Close button" Description="What happens when you close the main window.">
                <ComboBox MinWidth="160" ItemsSource="{x:Static local:SettingsOptions.CloseBehaviors}"
                          SelectedItem="{Binding CloseBehavior}" AutomationProperties.Name="Close button behavior" />
            </controls:SettingsCard>

            <!-- Quick add -->
            <TextBlock Text="Quick add" Style="{StaticResource SettingsGroupHeading}" />
            <controls:SettingsCard Header="Global shortcut"
                                   Description="Click the box and press a key combination.">
                <StackPanel Orientation="Horizontal">
                    <TextBox IsReadOnly="True" Width="180" IsReadOnlyCaretVisible="False"
                             AutomationProperties.Name="Global hotkey (press a key combination)"
                             Text="{Binding HotkeyText, Mode=OneWay}"
                             PreviewKeyDown="OnHotkeyPreviewKeyDown" />
                    <Button Content="Disable" Margin="8,0,0,0" Command="{Binding DisableHotkeyCommand}" />
                </StackPanel>
            </controls:SettingsCard>
            <controls:InfoBar Severity="Warning" Margin="0,2,0,0" AutomationProperties.Name="Shortcut problem"
                              Content="{Binding HotkeyError}">
                <controls:InfoBar.Style>
                    <Style TargetType="controls:InfoBar" BasedOn="{StaticResource {x:Type controls:InfoBar}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HotkeyError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:InfoBar.Style>
            </controls:InfoBar>

            <!-- Reminders -->
            <TextBlock Text="Reminders" Style="{StaticResource SettingsGroupHeading}" />
            <controls:SettingsCard Header="Default reminder time"
                                   Description="Used for date-only reminders, as HH:mm.">
                <TextBox Width="80" AutomationProperties.Name="Default reminder time"
                         Text="{Binding DefaultReminderTimeText, UpdateSourceTrigger=PropertyChanged}" />
            </controls:SettingsCard>
            <TextBlock Text="Enter a time such as 09:00." Foreground="{DynamicResource OverdueBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReminderTimeValid}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Data -->
            <TextBlock Text="Data" Style="{StaticResource SettingsGroupHeading}" />
            <controls:SettingsCard Header="Data folder" Description="Open the folder that holds your tasks and backups.">
                <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Export" Description="Save your tasks to a file.">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Export to JSON…" AutomationProperties.Name="Export everything to JSON"
                            Command="{Binding ExportJsonCommand}" />
                    <Button Content="Export to CSV…" Margin="8,0,0,0" AutomationProperties.Name="Export tasks to CSV"
                            Command="{Binding ExportCsvCommand}" />
                </StackPanel>
            </controls:SettingsCard>
            <TextBlock Style="{StaticResource StatusText}" Text="{Binding ExportStatus}" />
            <controls:SettingsCard Header="Import" Description="Merge or replace your data from a JSON export.">
                <Button Content="Import…" AutomationProperties.Name="Import a JSON export"
                        Command="{Binding ImportCommand}" />
            </controls:SettingsCard>
            <TextBlock Style="{StaticResource StatusText}" Text="{Binding ImportStatus}" />
            <controls:SettingsCard Header="Back up" Description="Save a copy of your database now.">
                <Button Content="Back up now" Command="{Binding BackUpNowCommand}" />
            </controls:SettingsCard>
            <TextBlock Style="{StaticResource StatusText}" Text="{Binding BackupStatus}" />

            <!-- About -->
            <TextBlock Text="About" Style="{StaticResource SettingsGroupHeading}" />
            <controls:SettingsCard Header="TaskDesk">
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding Version, StringFormat=Version {0}}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Data folder" Description="{Binding DataFolder}">
                <Button Content="Copy" AutomationProperties.Name="Copy data folder path"
                        Command="{Binding CopyDataFolderCommand}" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Log folder" Description="{Binding LogFolder}">
                <Button Content="Copy" AutomationProperties.Name="Copy log folder path"
                        Command="{Binding CopyLogFolderCommand}" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Window>
