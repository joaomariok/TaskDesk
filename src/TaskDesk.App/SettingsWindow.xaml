<Window x:Class="TaskDesk.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TaskDesk.App"
        Title="TaskDesk Settings" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock Text="Theme" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{x:Static local:SettingsOptions.Themes}"
                  SelectedItem="{Binding Theme}" AutomationProperties.Name="Theme" />

        <CheckBox Content="Start with Windows" Margin="0,12,0,0"
                  IsChecked="{Binding StartWithWindows}" />

        <TextBlock Text="When the close button is pressed" Margin="0,12,0,4" />
        <ComboBox ItemsSource="{x:Static local:SettingsOptions.CloseBehaviors}"
                  SelectedItem="{Binding CloseBehavior}" AutomationProperties.Name="Close button behavior" />

        <TextBlock Text="Default reminder time for date-only reminders (HH:mm)" Margin="0,12,0,4" />
        <TextBox Padding="4" HorizontalAlignment="Left" Width="80"
                 AutomationProperties.Name="Default reminder time"
                 Text="{Binding DefaultReminderTimeText, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Enter a time such as 09:00." Margin="0,4,0,0" Opacity="0.7">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsReminderTimeValid}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Text="Global quick-add shortcut" Margin="0,12,0,4" />
        <StackPanel Orientation="Horizontal">
            <TextBox IsReadOnly="True" Padding="4" Width="200" IsReadOnlyCaretVisible="False"
                     AutomationProperties.Name="Global hotkey (press a key combination)"
                     Text="{Binding HotkeyText, Mode=OneWay}"
                     PreviewKeyDown="OnHotkeyPreviewKeyDown" />
            <Button Content="Disable" Margin="8,0,0,0" Padding="12,4"
                    Command="{Binding DisableHotkeyCommand}" />
        </StackPanel>
        <TextBlock Text="Click the box and press a key combination." Margin="0,4,0,0" Opacity="0.7" />
        <TextBlock Text="{Binding HotkeyError}" Margin="0,4,0,0" Foreground="Firebrick" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HotkeyError}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Text="About" FontWeight="SemiBold" Margin="0,20,0,4" />
        <TextBlock Text="{Binding Version, StringFormat=Version {0}}" />
        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding DataFolder, StringFormat=Data folder: {0}}" />
        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding LogFolder, StringFormat=Log folder: {0}}" />
        <Button Content="Open data folder" Margin="0,12,0,0" Padding="12,4" HorizontalAlignment="Left"
                Command="{Binding OpenDataFolderCommand}" />
        <Button Content="Back up now" Margin="0,8,0,0" Padding="12,4" HorizontalAlignment="Left"
                Command="{Binding BackUpNowCommand}" />
        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.7" Text="{Binding BackupStatus}" />
    </StackPanel>
</Window>
