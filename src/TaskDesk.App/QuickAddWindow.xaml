<Window x:Class="TaskDesk.App.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskDesk quick add" Width="420" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>
    <Border BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            Padding="24" CornerRadius="{DynamicResource OverlayCornerRadius}">
        <StackPanel>
            <TextBlock x:Name="TitleLabel" Text="New Task" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="TitleBox" FontSize="20" Padding="10,8"
                     Margin="0,0,0,16"
                     AutomationProperties.Name="Task title"
                     AutomationProperties.LabeledBy="{Binding ElementName=TitleLabel}"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="ListLabel" Text="List" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Lists}" SelectedItem="{Binding SelectedList}"
                              DisplayMemberPath="Name" AutomationProperties.Name="List"
                              AutomationProperties.LabeledBy="{Binding ElementName=ListLabel}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="DueLabel" Text="Due" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding DueDate}" AutomationProperties.Name="Due date"
                                AutomationProperties.LabeledBy="{Binding ElementName=DueLabel}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Enter to add · Esc to cancel" Style="{StaticResource SecondaryCaptionText}"
                       Margin="0,16,0,0" />
        </StackPanel>
    </Border>
</Window>
