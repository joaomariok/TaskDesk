<Window x:Class="TaskDesk.App.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskDesk quick add" Width="420" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>
    <Border BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" Padding="16">
        <StackPanel>
            <TextBlock Text="Quick add" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBox x:Name="TitleBox" Padding="6" AutomationProperties.Name="Task title"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="List" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Lists}" SelectedItem="{Binding SelectedList}"
                              DisplayMemberPath="Name" AutomationProperties.Name="List" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Due date (optional)" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding DueDate}" AutomationProperties.Name="Due date" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Enter to save, Esc to cancel" Margin="0,10,0,0" Opacity="0.7" />
        </StackPanel>
    </Border>
</Window>
