<!--
    The default style of Controls/InfoBar: a Fluent InfoBar with informational and warning severities.
    Colours come from Fluent's own brushes, so Light, Dark and high contrast follow the theme.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:TaskDesk.App.Controls">

    <Style TargetType="{x:Type controls:InfoBar}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="12,4,4,4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:InfoBar}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Info (E946) or Warning (E7BA) glyph; decorative, the bar's name carries the meaning. -->
                            <TextBlock x:Name="Icon" Grid.Column="0" Text="&#xE946;" FontSize="16"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{DynamicResource SystemFillColorAttentionBrush}" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="0,4"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Button x:Name="ActionButton" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                                    Content="{TemplateBinding ActionContent}"
                                    Command="{TemplateBinding ActionCommand}"
                                    AutomationProperties.AutomationId="{TemplateBinding ActionAutomationId}" />
                            <Button x:Name="CloseButton" Grid.Column="3" VerticalAlignment="Center" Margin="4,0,0,0"
                                    Width="32" Height="32" Padding="0"
                                    Command="{TemplateBinding CloseCommand}"
                                    AutomationProperties.Name="Close" ToolTip="Close"
                                    Visibility="Collapsed">
                                <TextBlock Text="&#xE711;" FontSize="12" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Severity" Value="Warning">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                            <Setter TargetName="Icon" Property="Text" Value="&#xE7BA;" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                        </Trigger>
                        <Trigger Property="IsClosable" Value="True">
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ActionContent" Value="{x:Null}">
                            <Setter TargetName="ActionButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
