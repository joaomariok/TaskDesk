<!--
    The Due chip on a Task row: a small outlined pill whose colour says the Due state. The row's DataContext
    exposes DueState (Overdue, Today, Later, None). Colours come from the shared brushes (OverdueBrush,
    TodayBrush) and Fluent's neutral text and stroke brushes, so Light, Dark and high contrast follow the theme.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:TaskDesk.Presentation;assembly=TaskDesk.Presentation">

    <Style x:Key="DueChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DueState}" Value="{x:Static local:DueState.Overdue}">
                <Setter Property="BorderBrush" Value="{DynamicResource OverdueBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DueState}" Value="{x:Static local:DueState.Today}">
                <Setter Property="BorderBrush" Value="{DynamicResource TodayBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DueChipText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DueState}" Value="{x:Static local:DueState.Overdue}">
                <Setter Property="Foreground" Value="{DynamicResource OverdueBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DueState}" Value="{x:Static local:DueState.Today}">
                <Setter Property="Foreground" Value="{DynamicResource TodayBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
